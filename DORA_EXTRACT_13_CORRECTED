function Get-ApplicationNatureText {
    param([object]$App)

    try {
        if ($null -eq $App.characteristicCriteria -or $null -eq $App.characteristicCriteria.natures) {
            return "N/A"
        }

        $labels = @()
        foreach ($nat in $App.characteristicCriteria.natures) {
            if ($nat.labelEn) {
                $labels += [string]$nat.labelEn
            }
            elseif ($nat.code) {
                $labels += [string]$nat.code
            }
        }

        if ($labels.Count -eq 0) { return "N/A" }
        return ($labels -join "/")
    }
    catch {
        return "N/A"
    }
}

