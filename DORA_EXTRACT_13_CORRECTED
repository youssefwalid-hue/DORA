function Get-LatestFormattedDate {
    param([array]$Dates)

    $validDates = @()

    foreach ($d in $Dates) {
        if ($d -ne "N/A" -and -not [string]::IsNullOrWhiteSpace($d)) {
            try {
                $validDates += [datetime]::ParseExact(
                    $d,
                    "dd/MM/yyyy",
                    [System.Globalization.CultureInfo]::InvariantCulture
                )
            } catch {}
        }
    }

    if ($validDates.Count -eq 0) { return "N/A" }

    return ($validDates | Sort-Object -Descending | Select-Object -First 1).ToString("dd/MM/yyyy")
}

function Get-SastLatestDate {
    param([array]$Dates)
    return (Get-LatestFormattedDate -Dates $Dates)
}

