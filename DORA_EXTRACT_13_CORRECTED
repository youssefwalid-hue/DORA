function Enrich-DoraApplicationsWithDso360 {
    param(
        [Parameter(Mandatory = $true)][System.Collections.Generic.List[object]]$Applications,
        [Parameter(Mandatory = $true)][object]$DsoScans,
        [Parameter(Mandatory = $true)][hashtable]$HeadersDSO360
    )

    Write-Host ""
    Write-Host "============================================================" -ForegroundColor Cyan
    Write-Host "  PART 3: DSO360 ENRICHMENT (MATCH + MODULES + SAST)" -ForegroundColor Cyan
    Write-Host "============================================================" -ForegroundColor Cyan

    $devAppsCount        = 0
    $nonDevCount         = 0
    $totalModules        = 0
    $totalSastModules    = 0
    $moduleCallErrors    = 0
    $scaCoveredCount     = 0
    $sastCoveredCount    = 0
    $bothCoveredCount    = 0
    $withoutDsoScanCount = 0
    $totalApps           = $Applications.Count
    $currentIndex        = 0

    foreach ($doraApp in $Applications) {
        $currentIndex++

        try {
            $ciaKey = if ($doraApp.cia_key) { "$($doraApp.cia_key)".Trim().ToUpperInvariant() } else { "N/A" }

            $applicationName = Get-ApplicationDisplayName -App $doraApp
            if ([string]::IsNullOrWhiteSpace($applicationName)) {
                $applicationName = "Unknown application"
            }

            $natureText = Get-ApplicationNatureText -App $doraApp
            $isDev      = Test-IsSpecificDevelopment -App $doraApp

            if (-not $isDev) {
                $nonDevCount++

                $doraApp.DSO360_ScanExist             = "N/A"
                $doraApp.DSO360_Matched               = "N/A"
                $doraApp.DSO360_MatchType             = "N/A"
                $doraApp.DSO360_AppName               = "N/A"
                $doraApp.DSO360_ScanStatus            = "N/A"
                $doraApp.DSO360_SCA_Globale_LastScan  = "N/A"
                $doraApp.NB_Modules                   = "N/A"
                $doraApp.Liste_Modules                = "N/A"
                $doraApp.DSO360_SCA_Module_Last       = "N/A"
                $doraApp.DSO360_Modules_Detail        = "N/A"
                $doraApp.DSO360_Modules_Status        = "N/A"
                $doraApp.DSO360_ModuleFetchStatus     = "N/A"
                $doraApp.DSO360_ModuleFetchMessage    = "N/A"

                $doraApp.SAST_ScanExist               = "N/A"
                $doraApp.SAST_GlobalLastScan          = "N/A"
                $doraApp.SAST_NB_Modules              = "N/A"
                $doraApp.SAST_Liste_Modules           = "N/A"
                $doraApp.SAST_Module_LastScan         = "N/A"
                $doraApp.SAST_Modules_Detail          = "N/A"
                $doraApp.SAST_FetchStatus             = "N/A"
                $doraApp.SAST_FetchMessage            = "N/A"
                $doraApp.SAST_Modules_Raw             = $null
                $doraApp.CoverageStatus               = "NOT_APPLICABLE"

                Write-AppProcessingStatus `
                    -Current $currentIndex `
                    -Total $totalApps `
                    -CIA $ciaKey `
                    -ApplicationName $applicationName `
                    -Nature $natureText

                continue
            }

            $devAppsCount++
            $hasError = $false

            $matchResult = Find-Dso360Match `
                -DoraApp $doraApp `
                -MapByCia $DsoScans.MapByCia `
                -MapByName $DsoScans.MapByName `
                -NameKeys $DsoScans.NameKeys

            if ($matchResult.Found) {
                $doraApp.DSO360_ScanExist             = "No"
                $doraApp.DSO360_Matched               = $true
                $doraApp.DSO360_MatchType             = $matchResult.MatchType
                $doraApp.DSO360_AppName               = $matchResult.Match.AppName
                $doraApp.DSO360_ScanStatus            = $matchResult.Match.Status
                $doraApp.DSO360_SCA_Globale_LastScan  = "N/A"
                $doraApp.DSO360_RawEntry              = $matchResult.Match.RawEntry

                switch ($matchResult.MatchType) {
                    "CIA"          { $script:Stats.MatchingByCIA++ }
                    "EXACT_NAME"   { $script:Stats.MatchingByExactName++ }
                    "PARTIAL_NAME" { $script:Stats.MatchingByPartialName++ }
                }
            }
            else {
                $doraApp.DSO360_ScanExist             = "No"
                $doraApp.DSO360_Matched               = $false
                $doraApp.DSO360_MatchType             = "NONE"
                $doraApp.DSO360_AppName               = "N/A"
                $doraApp.DSO360_ScanStatus            = "N/A"
                $doraApp.DSO360_SCA_Globale_LastScan  = "N/A"
                $doraApp.DSO360_RawEntry              = $null

                $script:Stats.MatchingNone++
            }

            Write-AppProcessingStatus `
                -Current $currentIndex `
                -Total $totalApps `
                -CIA $ciaKey `
                -ApplicationName $applicationName `
                -Nature $natureText

            $scaDisplayMatchState  = "NO MATCH"
            $scaDisplayModules     = 0
            $scaDisplayLastScan    = "N/A"
            $scaDisplayStatus      = "SCA SCAN NOT EXIST IN DSO360"

            $sastDisplayMatchState = "NO MATCH"
            $sastDisplayModules    = 0
            $sastDisplayLastScan   = "N/A"
            $sastDisplayStatus     = "SAST SCAN NOT EXIST IN DSO360"

            $hasScaCoverage  = $false
            $hasSastCoverage = $false

            if (-not [string]::IsNullOrWhiteSpace($ciaKey) -and $ciaKey -ne "N/A") {
                $moduleResult = Get-CachedDso360ModulesByCia -CIA $ciaKey -Headers $HeadersDSO360

                $doraApp.DSO360_Modules_Status      = $moduleResult.Status
                $doraApp.DSO360_ModuleFetchStatus   = $moduleResult.Status
                $doraApp.DSO360_ModuleFetchMessage  = $moduleResult.Message
                $doraApp.DSO360_Modules_Raw         = $moduleResult.RawData

                if ($moduleResult.Status -eq "Success") {
                    $scaDisplayMatchState  = "MATCH"
                    $scaDisplayModules     = [int]$moduleResult.NombreModules
                    $scaDisplayLastScan    = if ($moduleResult.LastModuleScan) { $moduleResult.LastModuleScan } else { "N/A" }
                    $scaDisplayStatus      = "Success"

                    $doraApp.DSO360_ScanExist             = "Yes"
                    $doraApp.DSO360_SCA_Globale_LastScan  = if ($matchResult.Found -and $matchResult.Match -and $matchResult.Match.LastScan) { $matchResult.Match.LastScan } else { $moduleResult.LastModuleScan }
                    $doraApp.NB_Modules                   = [int]$moduleResult.NombreModules
                    $doraApp.DSO360_Modules_Detail        = $moduleResult.Modules
                    $doraApp.DSO360_SCA_Module_Last       = $moduleResult.LastModuleScan
                    $doraApp.Liste_Modules                = @(
                        $moduleResult.Modules | ForEach-Object {
                            if ($_.Version -and $_.Version -ne "N/A") {
                                "$($_.Name) [$($_.Version)]"
                            }
                            else {
                                "$($_.Name)"
                            }
                        }
                    )

                    $totalModules += [int]$moduleResult.NombreModules
                    $scaCoveredCount++
                    $hasScaCoverage = $true
                }
                else {
                    if ($moduleResult.Status -eq "Error") {
                        $moduleCallErrors++
                        $hasError = $true
                    }

                    $doraApp.DSO360_ScanExist             = "No"
                    $doraApp.DSO360_SCA_Globale_LastScan  = "N/A"
                    $doraApp.NB_Modules                   = 0
                    $doraApp.Liste_Modules                = @()
                    $doraApp.DSO360_SCA_Module_Last       = "N/A"
                    $doraApp.DSO360_Modules_Detail        = @()
                    $scaDisplayMatchState                 = "NO MATCH"
                    $scaDisplayModules                    = 0
                    $scaDisplayLastScan                   = "N/A"
                    $scaDisplayStatus                     = "SCA SCAN NOT EXIST IN DSO360"
                }

                $sastResult = Get-CachedCheckmarxSastModulesByCia -CIA $ciaKey -Headers $HeadersDSO360

                if ($sastResult.Status -eq "Success") {
                    $sastDisplayMatchState        = "MATCH"
                    $sastDisplayModules           = [int]$sastResult.NombreModules
                    $sastDisplayLastScan          = if ($sastResult.LastModuleScan) { $sastResult.LastModuleScan } else { "N/A" }
                    $sastDisplayStatus            = "Success"

                    $doraApp.SAST_ScanExist       = "Yes"
                    $doraApp.SAST_GlobalLastScan  = $sastResult.GlobalLastScan
                    $doraApp.SAST_NB_Modules      = [int]$sastResult.NombreModules
                    $doraApp.SAST_Module_LastScan = $sastResult.LastModuleScan
                    $doraApp.SAST_Modules_Detail  = $sastResult.Modules
                    $doraApp.SAST_Liste_Modules   = @($sastResult.Modules | ForEach-Object { $_.Name })
                    $doraApp.SAST_FetchStatus     = "Success"
                    $doraApp.SAST_FetchMessage    = "Success"
                    $doraApp.SAST_Modules_Raw     = $sastResult.RawData

                    $totalSastModules += [int]$sastResult.NombreModules
                    $sastCoveredCount++
                    $script:Stats.SastAppsMatched++
                    $hasSastCoverage = $true
                }
                else {
                    if ($sastResult.Status -eq "Error") {
                        $moduleCallErrors++
                        $hasError = $true
                    }

                    $sastDisplayMatchState        = "NO MATCH"
                    $sastDisplayModules           = 0
                    $sastDisplayLastScan          = "N/A"
                    $sastDisplayStatus            = "SAST SCAN NOT EXIST IN DSO360"

                    $doraApp.SAST_ScanExist       = "No"
                    $doraApp.SAST_GlobalLastScan  = "N/A"
                    $doraApp.SAST_NB_Modules      = 0
                    $doraApp.SAST_Module_LastScan = "N/A"
                    $doraApp.SAST_Modules_Detail  = @()
                    $doraApp.SAST_Liste_Modules   = @()
                    $doraApp.SAST_FetchStatus     = $sastResult.Status
                    $doraApp.SAST_FetchMessage    = $sastResult.Message
                    $doraApp.SAST_Modules_Raw     = $sastResult.RawData

                    $script:Stats.SastAppsNotFound++
                }
            }
            else {
                $hasError = $true

                $doraApp.DSO360_ScanExist             = "No"
                $doraApp.DSO360_Modules_Status        = "Error"
                $doraApp.DSO360_ModuleFetchStatus     = "Error"
                $doraApp.DSO360_ModuleFetchMessage    = "CIA is missing, unable to query DSO360 modules"
                $doraApp.DSO360_SCA_Globale_LastScan  = "N/A"
                $doraApp.NB_Modules                   = 0
                $doraApp.Liste_Modules                = @()
                $doraApp.DSO360_SCA_Module_Last       = "N/A"
                $doraApp.DSO360_Modules_Detail        = @()

                $doraApp.SAST_ScanExist               = "No"
                $doraApp.SAST_GlobalLastScan          = "N/A"
                $doraApp.SAST_NB_Modules              = 0
                $doraApp.SAST_Liste_Modules           = @()
                $doraApp.SAST_Module_LastScan         = "N/A"
                $doraApp.SAST_Modules_Detail          = @()
                $doraApp.SAST_FetchStatus             = "Error"
                $doraApp.SAST_FetchMessage            = "CIA is missing, unable to query Checkmarx SAST"
                $doraApp.SAST_Modules_Raw             = $null

                $scaDisplayMatchState  = "NO MATCH"
                $scaDisplayModules     = 0
                $scaDisplayLastScan    = "N/A"
                $scaDisplayStatus      = "SCA SCAN NOT EXIST IN DSO360"

                $sastDisplayMatchState = "NO MATCH"
                $sastDisplayModules    = 0
                $sastDisplayLastScan   = "N/A"
                $sastDisplayStatus     = "SAST SCAN NOT EXIST IN DSO360"

                $moduleCallErrors++
                Add-ExecutionEvent -Level "ERROR" -Step "ENRICHMENT" -System "REFA/DSO360" -Message "CIA is missing, unable to query technical endpoints." -Context $applicationName
            }

            $hasDsoMatch = [bool]$matchResult.Found
            $hasCia = (-not [string]::IsNullOrWhiteSpace($ciaKey) -and $ciaKey -ne "N/A")

            $doraApp.CoverageStatus = Get-CoverageStatus `
                -IsDev $true `
                -HasScaCoverage $hasScaCoverage `
                -HasSastCoverage $hasSastCoverage `
                -HasDsoMatch $hasDsoMatch `
                -HasCia $hasCia `
                -HasError $hasError

            if ($hasScaCoverage -and $hasSastCoverage) {
                $bothCoveredCount++
            }

            if (-not $hasScaCoverage) {
                $withoutDsoScanCount++
            }

            Write-ScanDetailLine `
                -Type "SCA" `
                -MatchState $scaDisplayMatchState `
                -ModuleCount $scaDisplayModules `
                -LastScan $scaDisplayLastScan `
                -Status $scaDisplayStatus

            Write-ScanDetailLine `
                -Type "SAST" `
                -MatchState $sastDisplayMatchState `
                -ModuleCount $sastDisplayModules `
                -LastScan $sastDisplayLastScan `
                -Status $sastDisplayStatus
        }
        catch {
            $script:Stats.ProcessingErrors++
            $moduleCallErrors++
            Add-ExecutionEvent -Level "ERROR" -Step "ENRICHMENT" -System "REFA/DSO360" -Message "Error while processing one application: $($_.Exception.Message)"
            Write-Warning "Error while processing one application: $_"
        }
    }

    $scaCoverageRate = 0
    $sastCoverageRate = 0
    $combinedCoverageRate = 0

    if ($devAppsCount -gt 0) {
        $scaCoverageRate      = [Math]::Round((($scaCoveredCount  / $devAppsCount) * 100), 2)
        $sastCoverageRate     = [Math]::Round((($sastCoveredCount / $devAppsCount) * 100), 2)
        $combinedCoverageRate = [Math]::Round((($bothCoveredCount / $devAppsCount) * 100), 2)
    }

    Write-Host ""
    Write-Host "  Enrichment summary:" -ForegroundColor Cyan
    Write-Host "  -> Total REFA applications                         : $($Applications.Count)" -ForegroundColor White
    Write-Host "  -> DEV applications                                : $devAppsCount" -ForegroundColor White
    Write-Host "  -> Non-DEV applications                            : $nonDevCount" -ForegroundColor White
    Write-Host "  -> DEV with SAST modules found / scans in DSO360  : $sastCoveredCount / $scaCoveredCount" -ForegroundColor Green
    Write-Host "  -> DEV without scan in DSO360                      : $withoutDsoScanCount" -ForegroundColor Yellow
    Write-Host "  -> Total SCA modules                               : $totalModules" -ForegroundColor Cyan
    Write-Host "  -> Total SAST modules                              : $totalSastModules" -ForegroundColor Cyan
    Write-Host "  -> SCA coverage rate on DEV applications           : $scaCoverageRate %" -ForegroundColor Cyan
    Write-Host "  -> SAST coverage rate on DEV applications          : $sastCoverageRate %" -ForegroundColor Cyan
    Write-Host "  -> SCA + SAST combined coverage rate               : $combinedCoverageRate %" -ForegroundColor Cyan
    Write-Host "  -> SCA cache hits / misses                         : $($script:Stats.ScaCacheHits) / $($script:Stats.ScaCacheMisses)" -ForegroundColor Gray
    Write-Host "  -> SAST cache hits / misses                        : $($script:Stats.SastCacheHits) / $($script:Stats.SastCacheMisses)" -ForegroundColor Gray

    return [PSCustomObject]@{
        Applications          = $Applications
        DevAppsCount          = $devAppsCount
        NonDevCount           = $nonDevCount
        TotalModules          = $totalModules
        TotalSastModules      = $totalSastModules
        ModuleCallErrors      = $moduleCallErrors
        ScaCoveredCount       = $scaCoveredCount
        SastCoveredCount      = $sastCoveredCount
        BothCoveredCount      = $bothCoveredCount
        WithoutDsoScanCount   = $withoutDsoScanCount
        ScaCoverageRate       = $scaCoverageRate
        SastCoverageRate      = $sastCoverageRate
        CombinedCoverageRate  = $combinedCoverageRate
        MatchedCount          = $scaCoveredCount
        UnmatchedCount        = $withoutDsoScanCount
        SuccessCount          = $scaCoveredCount
        SastMatchedCount      = $sastCoveredCount
        SastNotFoundCount     = ($devAppsCount - $sastCoveredCount)
    }
}

# ============================================================
# CSV EXPORT
# ============================================================

function Export-DevApplicationsCsv {
    param(
        [Parameter(Mandatory = $true)][System.Collections.Generic.List[object]]$Applications,
        [Parameter(Mandatory = $true)][string]$FilePath
    )

    $rows = @()

    foreach ($app in $Applications) {
        $isDev = Test-IsSpecificDevelopment -App $app
        if (-not $isDev) { continue }

        $rows += [PSCustomObject]@{
            CIA                        = if ($app.cia_key) { $app.cia_key } else { "" }
            ApplicationName            = Get-ApplicationDisplayName -App $app
            Nature                     = Get-ApplicationNatureText -App $app
            DSO360_Matched             = $app.DSO360_Matched
            DSO360_MatchType           = $app.DSO360_MatchType
            DSO360_AppName             = $app.DSO360_AppName
            SCA_Scan_Exists_In_DSO360  = $app.DSO360_ScanExist
            SCA_Global_Last_Scan_Date  = $app.DSO360_SCA_Globale_LastScan
            SCA_Last_Scan_Date         = $app.DSO360_SCA_Module_Last
            SCA_Scanned_Modules_Count  = $app.NB_Modules
            SCA_Fetch_Status           = $app.DSO360_ModuleFetchStatus
            SAST_Scan_Exists_In_DSO360 = $app.SAST_ScanExist
            SAST_Global_Last_Scan_Date = $app.SAST_GlobalLastScan
            SAST_Last_Scan_Date        = $app.SAST_Module_LastScan
            SAST_Scanned_Modules_Count = $app.SAST_NB_Modules
            SAST_Fetch_Status          = $app.SAST_FetchStatus
            CoverageStatus             = $app.CoverageStatus
        }
    }

    Export-CsvUtf8ExcelCompatible -Rows $rows -FilePath $FilePath -UseBomForExcel
}

# ============================================================
# METADATA
# ============================================================

function Build-ExecutionMetadata {
    param(
        [Parameter(Mandatory = $true)][object]$DoraData,
        [Parameter(Mandatory = $true)][object]$DsoData,
        [Parameter(Mandatory = $true)][object]$Consolidation
    )

    $detailByNature = @()
    foreach ($nat in $DoraData.NaturesConfig) {
        $nb = ($Consolidation.Applications | Where-Object {
            $_.characteristicCriteria.natures -and
            ($_.characteristicCriteria.natures | Where-Object { $_.code -eq $nat.code }).Count -gt 0
        }).Count

        $detailByNature += [PSCustomObject]@{
            code       = $nat.code
            labelEn    = $nat.labelEn
            labelFr    = $nat.labelFr
            legacyCode = $nat.legacyCode
            count      = $nb
        }
    }

    $totalErrors = `
        $script:Stats.DoraApiErrors + `
        $script:Stats.DsoApiErrors + `
        $script:Stats.ModuleApiErrors + `
        $script:Stats.ProcessingErrors + `
        $script:Stats.SastApiErrors + `
        $script:Stats.TokenValidationErrors + `
        $script:Stats.PlatformChecksFailed

    return [PSCustomObject]@{
        ExecutionDate                      = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        ScriptVersion                      = "3.6.2"
        MainPivotKey                       = "cia"
        Description                        = "Complete REFA extraction enriched with DSO360 SCA scans, SCA modules and Checkmarx SAST modules"
        OutputFile                         = $script:OutputPathJSON
        CsvOutputFile                      = $script:OutputPathCSV
        LogFile                            = $script:LogPath
        TotalDoraApplications              = $Consolidation.Applications.Count
        DevApplications                    = $Consolidation.DevAppsCount
        NonDevApplications                 = $Consolidation.NonDevCount
        TotalDso360Scans                   = $DsoData.AllScans.Count
        DevAppsWithScaCoverage             = $Consolidation.ScaCoveredCount
        DevAppsWithSastCoverage            = $Consolidation.SastCoveredCount
        DevAppsWithScaAndSastCoverage      = $Consolidation.BothCoveredCount
        DevAppsWithoutScaCoverage          = $Consolidation.WithoutDsoScanCount
        ScaCoverageRatePercent             = $Consolidation.ScaCoverageRate
        SastCoverageRatePercent            = $Consolidation.SastCoverageRate
        CombinedCoverageRatePercent        = $Consolidation.CombinedCoverageRate
        MatchingByCIA                      = $script:Stats.MatchingByCIA
        MatchingByExactName                = $script:Stats.MatchingByExactName
        MatchingByPartialName              = $script:Stats.MatchingByPartialName
        MatchingWithoutResult              = $script:Stats.MatchingNone
        ApplicationsWithNature             = $DoraData.AppsWithNature
        ApplicationsWithoutNature          = $DoraData.AppsWithoutNature
        StatisticsByCharacteristicCriteria = $detailByNature
        TotalModules                       = $Consolidation.TotalModules
        TotalSastModules                   = $Consolidation.TotalSastModules
        SastAppsMatched                    = $script:Stats.SastAppsMatched
        SastAppsNotFound                   = $script:Stats.SastAppsNotFound
        ScaCacheHits                       = $script:Stats.ScaCacheHits
        ScaCacheMisses                     = $script:Stats.ScaCacheMisses
        SastCacheHits                      = $script:Stats.SastCacheHits
        SastCacheMisses                    = $script:Stats.SastCacheMisses
        RetryCount                         = $script:Stats.RetryCount
        DoraFallbackUsed                   = $script:Stats.FallbackUsed
        DoraCountFallbackUsed              = $script:Stats.DoraCountFallbackUsed
        PlatformChecksFailed               = $script:Stats.PlatformChecksFailed
        ErrorAnomalyCount                  = $totalErrors
        WarningCount                       = $script:Stats.Warnings
        DoraApiErrors                      = $script:Stats.DoraApiErrors
        DsoApiErrors                       = $script:Stats.DsoApiErrors
        ModuleApiErrors                    = $script:Stats.ModuleApiErrors
        SastApiErrors                      = $script:Stats.SastApiErrors
        ProcessingErrors                   = $script:Stats.ProcessingErrors
        TokenValidationErrors              = $script:Stats.TokenValidationErrors
        Dso360Summary                      = $DsoData.Summary
    }
}

# ============================================================
# FINAL REPORT / SYNTHESIS
# ============================================================

function Show-ExecutionAnomalySummary {
    $warnings = @($script:ExecutionEvents | Where-Object { $_.Level -eq "WARN" })
    $errors   = @($script:ExecutionEvents | Where-Object { $_.Level -eq "ERROR" })

    Write-Host ""
    Write-Host "============================================================" -ForegroundColor DarkYellow
    Write-Host "  END-OF-RUN ANOMALY SUMMARY" -ForegroundColor DarkYellow
    Write-Host "============================================================" -ForegroundColor DarkYellow
    Write-Host "  Warnings : $($warnings.Count)" -ForegroundColor Yellow
    Write-Host "  Errors   : $($errors.Count)" -ForegroundColor Red

    if ($errors.Count -gt 0) {
        Write-Host ""
        Write-Host "  Last errors:" -ForegroundColor Red
        foreach ($e in ($errors | Select-Object -Last 10)) {
            Write-Host ("  - [{0}] [{1}] {2}" -f $e.Step, $(if($e.HttpCode){$e.HttpCode}else{"N/A"}), $e.Message) -ForegroundColor Red
        }
    }

    if ($warnings.Count -gt 0) {
        Write-Host ""
        Write-Host "  Last warnings:" -ForegroundColor Yellow
        foreach ($w in ($warnings | Select-Object -Last 10)) {
            Write-Host ("  - [{0}] [{1}] {2}" -f $w.Step, $(if($w.HttpCode){$w.HttpCode}else{"N/A"}), $w.Message) -ForegroundColor Yellow
        }
    }

    Add-ExecutionEvent -Level "INFO" -Step "SUMMARY" -Message ("End-of-run summary: warnings={0}, errors={1}" -f $warnings.Count, $errors.Count)
}

function Show-ExecutionReport {
    param(
        [Parameter(Mandatory = $true)][object]$Metadata,
        [Parameter(Mandatory = $true)][string]$JsonOutputPath,
        [Parameter(Mandatory = $true)][string]$CsvOutputPath
    )

    Write-Host ""
    Write-Host "============================================================" -ForegroundColor Magenta
    Write-Host "  FINAL EXECUTION REPORT" -ForegroundColor Magenta
    Write-Host "============================================================" -ForegroundColor Magenta

    $globalStatus = if ($Metadata.ErrorAnomalyCount -gt 0) { "COMPLETED WITH ANOMALIES" } else { "SUCCESS" }
    $globalColor  = if ($Metadata.ErrorAnomalyCount -gt 0) { "Yellow" } else { "Green" }

    Write-Host "  Global status                        : $globalStatus" -ForegroundColor $globalColor
    Write-Host "  Applications processed               : $($Metadata.TotalDoraApplications)" -ForegroundColor White
    Write-Host "  DEV applications                     : $($Metadata.DevApplications)" -ForegroundColor White
    Write-Host "  Non-DEV applications                 : $($Metadata.NonDevApplications)" -ForegroundColor White
    Write-Host "  DEV applications with SCA coverage   : $($Metadata.DevAppsWithScaCoverage)" -ForegroundColor Green
    Write-Host "  DEV applications with SAST coverage  : $($Metadata.DevAppsWithSastCoverage)" -ForegroundColor Green
    Write-Host "  DEV applications with both coverages : $($Metadata.DevAppsWithScaAndSastCoverage)" -ForegroundColor Green
    Write-Host "  DEV applications without SCA scan    : $($Metadata.DevAppsWithoutScaCoverage)" -ForegroundColor Yellow
    Write-Host "  Total SCA modules                    : $($Metadata.TotalModules)" -ForegroundColor Cyan
    Write-Host "  Total SAST modules                   : $($Metadata.TotalSastModules)" -ForegroundColor Cyan
    Write-Host "  SCA coverage rate                    : $($Metadata.ScaCoverageRatePercent) %" -ForegroundColor Cyan
    Write-Host "  SAST coverage rate                   : $($Metadata.SastCoverageRatePercent) %" -ForegroundColor Cyan
    Write-Host "  Combined coverage rate               : $($Metadata.CombinedCoverageRatePercent) %" -ForegroundColor Cyan
    Write-Host "  SCA cache hits / misses              : $($Metadata.ScaCacheHits) / $($Metadata.ScaCacheMisses)" -ForegroundColor Gray
    Write-Host "  SAST cache hits / misses             : $($Metadata.SastCacheHits) / $($Metadata.SastCacheMisses)" -ForegroundColor Gray
    Write-Host "  Retries performed                    : $($Metadata.RetryCount)" -ForegroundColor Gray
    Write-Host "  REFA fallback usage                  : $($Metadata.DoraFallbackUsed)" -ForegroundColor Gray
    Write-Host "  REFA count fallback usage            : $($Metadata.DoraCountFallbackUsed)" -ForegroundColor Gray
    Write-Host "  Platform check failures              : $($Metadata.PlatformChecksFailed)" -ForegroundColor Gray
    Write-Host "  Errors / anomalies                   : $($Metadata.ErrorAnomalyCount)" -ForegroundColor Red
    Write-Host "  JSON output file                     : $JsonOutputPath" -ForegroundColor Green
    Write-Host "  CSV output file                      : $CsvOutputPath" -ForegroundColor Green
    Write-Host "  Log file                             : $($Metadata.LogFile)" -ForegroundColor Green
    Write-Host ""
    Write-Host "============================================================" -ForegroundColor Magenta
}

# ============================================================
# STARTUP BANNER
# ============================================================
Clear-Host
Initialize-LogFile

Write-Host ""
Write-Host "============================================================" -ForegroundColor Magenta
Write-Host "  FINAL UNIFIED SCRIPT: REFA x DSO360 x Checkmarx SAST - Security KPI Extract" -ForegroundColor Magenta
Write-Host "  Date: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" -ForegroundColor Magenta
Write-Host "============================================================" -ForegroundColor Magenta
Write-Host ""

Add-ExecutionEvent -Level "INFO" -Step "STARTUP" -Message "Script started."

# ============================================================
# AUTHENTICATION
# ============================================================

$instructionsDORA = @"
Steps to retrieve the REFA token:
  1. Sign in to REFA
  2. Open developer tools (F12) > Network tab
  3. Perform an action (application search)
  4. Click an API request > Headers > Authorization
  5. Copy the full value (Bearer eyJ...)
"@

$instructionsDSO360 = @"
Steps to retrieve the DSO360 token:
  1. Sign in to DSO360
  2. Open developer tools (F12) > Network tab
  3. Refresh the page or perform an action
  4. Filter requests on 'dso-api'
  5. Click a request > Headers > Authorization
  6. Copy the full value (Bearer eyJ...)
"@

Write-Host ""
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host " PLATFORM AVAILABILITY CHECK" -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan

$refaOnline = Test-PlatformAvailability `
    -PlatformName "REFA" `
    -BaseUrls $script:BaseUrlDORAFallbacks `
    -HealthRelativeUri $script:RefaHealthRelativeUri

if (-not $refaOnline) {
    Write-Host "ERROR - REFA platform is currently unreachable." -ForegroundColor Red
    Write-Host "Please verify network access, VPN, proxy, or platform availability before retrying." -ForegroundColor Red
    Show-ExecutionAnomalySummary
    exit 1
}

$dsoOnline = Test-PlatformAvailability `
    -PlatformName "DSO360" `
    -BaseUrls @($script:BaseUrlDSO360, $script:BaseUrlDSO360API) `
    -HealthRelativeUri $script:DsoHealthRelativeUri

if (-not $dsoOnline) {
    Write-Host "ERROR - DSO360 platform is currently unreachable." -ForegroundColor Red
    Write-Host "Please verify network access, VPN, proxy, or platform availability before retrying." -ForegroundColor Red
    Show-ExecutionAnomalySummary
    exit 1
}

Write-Host "OK - REFA platform is reachable." -ForegroundColor Green
Write-Host "OK - DSO360 platform is reachable." -ForegroundColor Green

$tokenDORA = Get-ValidatedBearerToken `
    -SystemName "REFA" `
    -SystemUrl $script:BaseUrlDORA `
    -Instructions $instructionsDORA `
    -HeaderFactory { param($token) New-DoraHeaders -Token $token } `
    -TokenValidator { param($headers) Test-DoraToken -Headers $headers } `
    -MaxValidationAttempts 3

$tokenDSO360 = Get-ValidatedBearerToken `
    -SystemName "DSO360" `
    -SystemUrl $script:BaseUrlDSO360 `
    -Instructions $instructionsDSO360 `
    -HeaderFactory { param($token) New-Dso360Headers -Token $token } `
    -TokenValidator { param($headers) Test-Dso360Token -Headers $headers } `
    -MaxValidationAttempts 3

$headersDORA   = New-DoraHeaders -Token $tokenDORA
$headersDSO360 = New-Dso360Headers -Token $tokenDSO360

Write-Host ""
Write-Host "============================================================" -ForegroundColor Green
Write-Host " Both tokens validated successfully. Starting processing..." -ForegroundColor Green
Write-Host "============================================================" -ForegroundColor Green
Write-Host ""

# ============================================================
# MAIN EXECUTION
# ============================================================

try {
    $doraData = Get-DoraApplications -Headers $headersDORA
    $dsoData  = Get-Dso360Scans -Headers $headersDSO360

    $consolidation = Enrich-DoraApplicationsWithDso360 `
        -Applications $doraData.EnrichedApps `
        -DsoScans $dsoData `
        -HeadersDSO360 $headersDSO360

    $metadata = Build-ExecutionMetadata `
        -DoraData $doraData `
        -DsoData $dsoData `
        -Consolidation $consolidation

    $globalOutput = [PSCustomObject]@{
        Metadata = $metadata
        Events   = $script:ExecutionEvents
        Data     = $consolidation.Applications
    }

    Write-Host ""
    Write-Host "============================================================" -ForegroundColor Cyan
    Write-Host "  PART 4: SAVING OUTPUT FILES" -ForegroundColor Cyan
    Write-Host "============================================================" -ForegroundColor Cyan

    Save-JsonUTF8 -FilePath $script:OutputPathJSON -Data $globalOutput

    Export-DevApplicationsCsv `
        -Applications $consolidation.Applications `
        -FilePath $script:OutputPathCSV

    $resolvedJsonOutput = try { (Resolve-Path $script:OutputPathJSON).Path } catch { $script:OutputPathJSON }
    $resolvedCsvOutput  = try { (Resolve-Path $script:OutputPathCSV).Path } catch { $script:OutputPathCSV }
    $resolvedLogOutput  = try { (Resolve-Path $script:LogPath).Path } catch { $script:LogPath }

    Write-Host ""
    Write-Host "OK - Output files saved:" -ForegroundColor Green
    Write-Host "     JSON file : $resolvedJsonOutput" -ForegroundColor White
    Write-Host "     CSV file  : $resolvedCsvOutput" -ForegroundColor White
    Write-Host "     LOG file  : $resolvedLogOutput" -ForegroundColor White
    Write-Host "     JSON size : $([math]::Round((Get-Item $script:OutputPathJSON).Length / 1KB, 2)) KB" -ForegroundColor White
    Write-Host "     CSV size  : $([math]::Round((Get-Item $script:OutputPathCSV).Length / 1KB, 2)) KB" -ForegroundColor White
    Write-Host "     LOG size  : $([math]::Round((Get-Item $script:LogPath).Length / 1KB, 2)) KB" -ForegroundColor White
    Write-Host "     Encoding  : UTF-8 with BOM (JSON/CSV/log)" -ForegroundColor White
    Write-Host "     Applications: $($consolidation.Applications.Count)" -ForegroundColor White

    Show-ExecutionAnomalySummary

    Show-ExecutionReport `
        -Metadata $metadata `
        -JsonOutputPath $resolvedJsonOutput `
        -CsvOutputPath $resolvedCsvOutput

    Add-ExecutionEvent -Level "INFO" -Step "END" -Message "Script completed."
}
catch {
    $script:Stats.ProcessingErrors++
    Add-ExecutionEvent -Level "ERROR" -Step "MAIN" -Message $_.Exception.Message

    Write-Host ""
    Write-Host "============================================================" -ForegroundColor Red
    Write-Host "  SCRIPT FAILURE" -ForegroundColor Red
    Write-Host "============================================================" -ForegroundColor Red
    Write-Host "Error: $_" -ForegroundColor Red

    try {
        Show-ExecutionAnomalySummary
    } catch {}

    exit 1
}
finally {
    try {
        $duration = New-TimeSpan -Start $script:ExecutionStart -End (Get-Date)
        Add-ExecutionEvent -Level "INFO" -Step "FINALLY" -Message ("Execution duration: {0:hh\:mm\:ss}" -f $duration)
    } catch {}
}
