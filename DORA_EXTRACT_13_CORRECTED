}

function Get-CoverageStatus {
    param(
        [bool]$IsDev,
        [bool]$HasScaCoverage,
        [bool]$HasSastCoverage,
        [bool]$HasDsoMatch,
        [bool]$HasCia,
        [bool]$HasError
    )

    if (-not $IsDev) { return "NOT_APPLICABLE" }
    if (-not $HasCia) { return "CIA_MISSING" }
    if ($HasError) { return "ERROR" }
    if ($HasScaCoverage -and $HasSastCoverage) { return "SCA_AND_SAST_FOUND" }
    if ($HasScaCoverage -and -not $HasSastCoverage) { return "SCA_ONLY" }
    if (-not $HasScaCoverage -and $HasSastCoverage) { return "SAST_ONLY" }
    if ($HasDsoMatch -and -not $HasScaCoverage) { return "MATCH_ONLY_NO_SCA" }
    return "NO_SCAN_FOUND"
}

