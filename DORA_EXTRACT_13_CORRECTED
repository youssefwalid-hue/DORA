# ============================================================
# DORA-SPECIFIC FALLBACK HELPERS
# ============================================================

function Get-DoraSearchResultItems {
    param([object]$SearchResponse)

    if ($null -eq $SearchResponse) { return @() }

    if ($SearchResponse -is [System.Array]) {
        return @($SearchResponse)
    }

    $candidateProperties = @(
        "results",
        "content",
        "items",
        "data",
        "records",
        "applications",
        "list"
    )

    foreach ($prop in $candidateProperties) {
        if ($SearchResponse.PSObject.Properties.Name -contains $prop -and $null -ne $SearchResponse.$prop) {
            if ($SearchResponse.$prop -is [System.Array]) {
                return @($SearchResponse.$prop)
            } else {
                return @($SearchResponse.$prop)
            }
        }
    }

    return @($SearchResponse)
}

function Get-DoraSearchReportedTotal {
    param([object]$SearchResponse)

    if ($null -eq $SearchResponse) { return $null }

    $topLevelCandidates = @(
        "totalElements",
        "total",
        "count",
        "totalCount",
        "numberOfElements"
    )

    foreach ($prop in $topLevelCandidates) {
        if ($SearchResponse.PSObject.Properties.Name -contains $prop) {
            try {
                return [int]$SearchResponse.$prop
            } catch {}
        }
    }

    if ($SearchResponse.PSObject.Properties.Name -contains "page" -and $null -ne $SearchResponse.page) {
        foreach ($prop in @("totalElements","total","count","totalCount")) {
            if ($SearchResponse.page.PSObject.Properties.Name -contains $prop) {
                try {
                    return [int]$SearchResponse.page.$prop
                } catch {}
            }
        }
    }

    return $null
}

function Get-DoraSearchReportedTotalPages {
    param([object]$SearchResponse)

    if ($null -eq $SearchResponse) { return $null }

    foreach ($prop in @("totalPages","pageCount")) {
        if ($SearchResponse.PSObject.Properties.Name -contains $prop) {
            try {
                return [int]$SearchResponse.$prop
            } catch {}
        }
    }

    if ($SearchResponse.PSObject.Properties.Name -contains "page" -and $null -ne $SearchResponse.page) {
        foreach ($prop in @("totalPages","pageCount")) {
            if ($SearchResponse.page.PSObject.Properties.Name -contains $prop) {
                try {
                    return [int]$SearchResponse.page.$prop
                } catch {}
            }
        }
    }

    return $null
}

function Get-DoraTotalApplicationsSafe {
    param(
        [Parameter(Mandatory = $true)][hashtable]$Headers,
        [Parameter(Mandatory = $true)][object]$CountBody
    )

    try {
        $countResult = Invoke-DoraApiMultiEndpoint `
            -RelativeUris $script:DoraCountRelativeUris `
            -Method "POST" `
            -Headers $Headers `
            -Body $CountBody `
            -Step "REFA-COUNT"

        return [PSCustomObject]@{
            Count            = [int]$countResult
            Source           = "COUNT_ENDPOINT"
            FirstPageData    = $null
            TotalPages       = $null
        }
    }
    catch {
        $statusCode = Get-HttpStatusCodeFromError -ErrorRecord $_

        if ($statusCode -eq 403) {
            $script:Stats.DoraCountFallbackUsed++
            Add-ExecutionEvent -Level "WARN" -Step "REFA-COUNT" -System "REFA" -HttpCode "403" -Message "REFA /count forbidden. Falling back to /search-based discovery."
        } else {
            Add-ExecutionEvent -Level "WARN" -Step "REFA-COUNT" -System "REFA" -HttpCode $(if($statusCode){"$statusCode"}else{""}) -Message "REFA /count failed. Falling back to /search-based discovery."
        }
    }

    $firstPageBody = New-DoraBaseSearchObject -PageNumber 1 -PageSize $script:PageSizeDORA
    $firstPageData = Invoke-DoraApiMultiEndpoint `
        -RelativeUris $script:DoraSearchRelativeUris `
        -Method "POST" `
        -Headers $Headers `
        -Body $firstPageBody `
        -Step "REFA-SEARCH-FIRSTPAGE"

    $items = Get-DoraSearchResultItems -SearchResponse $firstPageData
    $reportedTotal = Get-DoraSearchReportedTotal -SearchResponse $firstPageData
    $reportedTotalPages = Get-DoraSearchReportedTotalPages -SearchResponse $firstPageData

    if ($reportedTotal -ne $null -and $reportedTotal -ge 0) {
        return [PSCustomObject]@{
            Count            = [int]$reportedTotal
            Source           = "SEARCH_REPORTED_TOTAL"
            FirstPageData    = $firstPageData
            TotalPages       = $reportedTotalPages
        }
    }

    return [PSCustomObject]@{
        Count            = @($items).Count
        Source           = "SEARCH_PROGRESSIVE"
        FirstPageData    = $firstPageData
        TotalPages       = $reportedTotalPages
    }
}

# ============================================================
# REFA EXTRACTION
# ============================================================

function Get-DoraApplications {
    param(
        [Parameter(Mandatory = $true)][hashtable]$Headers
    )

    Write-Host ""
    Write-Host "============================================================" -ForegroundColor Cyan
    Write-Host "  PART 1: REFA APPLICATION EXTRACTION" -ForegroundColor Cyan
    Write-Host "============================================================" -ForegroundColor Cyan

    Write-Host ""
    Write-Host "[REFA-1] Resolving total application count..." -ForegroundColor Cyan

    $bodyCount = New-DoraBaseSearchObject -PageNumber 1 -PageSize $script:PageSizeDORA

    try {
        $countInfo = Get-DoraTotalApplicationsSafe -Headers $Headers -CountBody $bodyCount
        $totalAppsInt = [int]$countInfo.Count

        Write-Host "OK - Total number of REFA applications: $totalAppsInt" -ForegroundColor Green
        Write-Host "     Count source: $($countInfo.Source)" -ForegroundColor Gray

        Add-ExecutionEvent -Level "INFO" -Step "REFA-COUNT" -System "REFA" -Message "Total applications: $totalAppsInt (source=$($countInfo.Source))"
    }
    catch {
        Add-ExecutionEvent -Level "ERROR" -Step "REFA-COUNT" -System "REFA" -Message $_.Exception.Message
        Write-Error "ERROR while resolving REFA application count: $_"
        exit 1
    }

    Write-Host ""
    Write-Host "[REFA-2] Retrieving all REFA applications..." -ForegroundColor Cyan

    $allAppsDORA = @()

    if ($countInfo.Source -eq "SEARCH_PROGRESSIVE") {
        Write-Host "Progressive mode enabled (no reliable total returned by REFA search)." -ForegroundColor Yellow

        $page = 1
        $keepGoing = $true

        while ($keepGoing) {
            try {
                if ($page -eq 1 -and $null -ne $countInfo.FirstPageData) {
                    $pageData = $countInfo.FirstPageData
                }
                else {
                    Write-Host "  -> Page $page ..." -ForegroundColor Yellow
                    $bodySearch = New-DoraBaseSearchObject -PageNumber $page -PageSize $script:PageSizeDORA

                    $pageData = Invoke-DoraApiMultiEndpoint `
                        -RelativeUris $script:DoraSearchRelativeUris `
                        -Method "POST" `
                        -Headers $Headers `
                        -Body $bodySearch `
                        -Step "REFA-SEARCH"
                }

                $items = Get-DoraSearchResultItems -SearchResponse $pageData

                if ($items.Count -eq 0) {
                    $keepGoing = $false
                    break
                }

                $allAppsDORA += $items
                Write-Host "    OK - $($allAppsDORA.Count) applications loaded so far." -ForegroundColor Green

                if ($items.Count -lt $script:PageSizeDORA) {
                    $keepGoing = $false
                }
                else {
                    $page++
                }
            }
            catch {
                $script:Stats.Warnings++
                Add-ExecutionEvent -Level "WARN" -Step "REFA-SEARCH" -System "REFA" -Endpoint "/api/application/search" -Message "Error on page $page : $($_.Exception.Message)"
                Write-Warning "ERROR on REFA page $page : $_"
                break
            }
        }

        $totalAppsInt = $allAppsDORA.Count
        Add-ExecutionEvent -Level "INFO" -Step "REFA-SEARCH" -System "REFA" -Message "Progressive search mode completed. Final item count: $totalAppsInt"
    }
    else {
        $totalPagesDORA = if ($countInfo.TotalPages -and $countInfo.TotalPages -gt 0) {
            [int]$countInfo.TotalPages
        } else {
            [Math]::Ceiling($totalAppsInt / $script:PageSizeDORA)
        }

        Write-Host "Pages to retrieve: $totalPagesDORA (pageSize = $($script:PageSizeDORA))" -ForegroundColor White

        for ($page = 1; $page -le $totalPagesDORA; $page++) {
            Write-Host "  -> Page $page / $totalPagesDORA ..." -ForegroundColor Yellow

            try {
                if ($page -eq 1 -and $null -ne $countInfo.FirstPageData) {
                    $pageData = $countInfo.FirstPageData
                }
                else {
                    $bodySearch = New-DoraBaseSearchObject -PageNumber $page -PageSize $script:PageSizeDORA

                    $pageData = Invoke-DoraApiMultiEndpoint `
                        -RelativeUris $script:DoraSearchRelativeUris `
                        -Method "POST" `
                        -Headers $Headers `
                        -Body $bodySearch `
                        -Step "REFA-SEARCH"
                }

                $items = Get-DoraSearchResultItems -SearchResponse $pageData
                if ($items.Count -gt 0) {
                    $allAppsDORA += $items
                }

                Write-Host "    OK - $($allAppsDORA.Count) applications loaded so far." -ForegroundColor Green
            }
            catch {
                $script:Stats.Warnings++
                Add-ExecutionEvent -Level "WARN" -Step "REFA-SEARCH" -System "REFA" -Endpoint "/api/application/search" -Message "Error on page $page : $($_.Exception.Message)"
                Write-Warning "ERROR on REFA page $page : $_"
                break
            }
        }
    }

    Write-Host ""
    Write-Host "[REFA-3] Retrieving development natures..." -ForegroundColor Cyan

    $appNaturesMap = @{}
    $naturesConfig = Get-DoraNatureConfigurations

    foreach ($nat in $naturesConfig) {
        Write-Host "  -> Nature [$($nat.code)] $($nat.labelEn)..." -ForegroundColor Yellow

        $bodyNature = New-DoraNatureSearchBody `
            -NatureCode $nat.code `
            -LabelEn $nat.labelEn `
            -LabelFr $nat.labelFr `
            -LegacyCode $nat.legacyCode

        try {
            $natData = Invoke-DoraApiMultiEndpoint `
                -RelativeUris $script:DoraSearchRelativeUris `
                -Method "POST" `
                -Headers $Headers `
                -Body $bodyNature `
                -Step "REFA-NATURE"

            $natList = Get-DoraSearchResultItems -SearchResponse $natData

            $count = 0
            foreach ($app in $natList) {
                $ciaKey = if ($app.cia) { $app.cia } else { $app.groupId }
                if ([string]::IsNullOrWhiteSpace($ciaKey)) { continue }

                if (-not $appNaturesMap.ContainsKey($ciaKey)) {
                    $appNaturesMap[$ciaKey] = [System.Collections.Generic.List[object]]::new()
                }

                $appNaturesMap[$ciaKey].Add([PSCustomObject]@{
                    code       = $nat.code
                    labelEn    = $nat.labelEn
                    labelFr    = $nat.labelFr
                    legacyCode = $nat.legacyCode
                })
                $count++
            }

            Write-Host "     OK - $count application(s) found." -ForegroundColor Green
        }
        catch {
            $script:Stats.Warnings++
            Add-ExecutionEvent -Level "WARN" -Step "REFA-NATURE" -System "REFA" -Message "Error for nature [$($nat.code)] : $($_.Exception.Message)"
            Write-Warning "     WARNING - Error for [$($nat.code)] : $_"
        }
    }

    $appsWithNature    = ($appNaturesMap.Keys | Measure-Object).Count
    $appsWithoutNature = $allAppsDORA.Count - $appsWithNature

    Write-Host ""
    Write-Host "  Nature summary:" -ForegroundColor Cyan
    Write-Host "  -> $appsWithNature with identified nature" -ForegroundColor White
    Write-Host "  -> $appsWithoutNature without identified nature" -ForegroundColor White

    Write-Host ""
    Write-Host "[REFA-4] Merging REFA data + natures..." -ForegroundColor Cyan

    $enrichedAppsDORA = [System.Collections.Generic.List[object]]::new()

    foreach ($app in $allAppsDORA) {
        try {
            $ciaKey = if ($app.cia) { $app.cia } else { $app.groupId }

            if (-not [string]::IsNullOrWhiteSpace($ciaKey) -and $appNaturesMap.ContainsKey($ciaKey)) {
                $naturesFound = $appNaturesMap[$ciaKey]
                $codes        = ($naturesFound | ForEach-Object { $_.code }) -join " | "
                $labelsEn     = ($naturesFound | ForEach-Object { $_.labelEn }) -join " | "
                $labelsFr     = ($naturesFound | ForEach-Object { $_.labelFr }) -join " | "

                $criteriaValue = [PSCustomObject]@{
                    isCurrentVersion = $true
                    natures          = $naturesFound
                    hasNature        = $true
                    natureSummary    = [PSCustomObject]@{
                        codes    = $codes
                        labelsEn = $labelsEn
                        labelsFr = $labelsFr
                    }
                }
            }
            else {
                $criteriaValue = [PSCustomObject]@{
                    isCurrentVersion = $true
                    natures          = @()
                    hasNature        = $false
                    natureSummary    = [PSCustomObject]@{
                        codes    = ""
                        labelsEn = "No development nature identified"
                        labelsFr = "No development nature identified"
                    }
                }
            }

            $enrichedAppJson = $app | ConvertTo-Json -Depth 20
            $enrichedApp = ConvertFrom-JsonUtf8Text -JsonText $enrichedAppJson
            $enrichedApp | Add-Member -NotePropertyName "cia_key" -NotePropertyValue $ciaKey -Force
            $enrichedApp | Add-Member -NotePropertyName "characteristicCriteria" -NotePropertyValue $criteriaValue -Force
            $enrichedApp | Add-Member -NotePropertyName "extractionDate" -NotePropertyValue (Get-Date -Format "yyyy-MM-dd HH:mm:ss") -Force

            $naFields = New-NaFields
            foreach ($field in $naFields.Keys) {
                $enrichedApp | Add-Member -NotePropertyName $field -NotePropertyValue $naFields[$field] -Force
            }

            $enrichedAppsDORA.Add($enrichedApp)
        }
        catch {
            $script:Stats.ProcessingErrors++
            Add-ExecutionEvent -Level "WARN" -Step "REFA-MERGE" -System "REFA" -Message "Unable to enrich a REFA application: $($_.Exception.Message)"
            Write-Warning "Unable to enrich a REFA application: $_"
        }
    }

    Write-Host "OK - $($enrichedAppsDORA.Count) REFA applications enriched with nature data." -ForegroundColor Green

    return [PSCustomObject]@{
        TotalApps         = $totalAppsInt
        AllApps           = $allAppsDORA
        EnrichedApps      = $enrichedAppsDORA
        AppsWithNature    = $appsWithNature
        AppsWithoutNature = $appsWithoutNature
        NaturesConfig     = $naturesConfig
        NaturesMap        = $appNaturesMap
    }
}

# ============================================================
# DSO360 - GLOBAL SCANS
# ============================================================

function Get-Dso360Scans {
    param(
        [Parameter(Mandatory = $true)][hashtable]$Headers
    )

    Write-Host ""
    Write-Host "============================================================" -ForegroundColor Cyan
    Write-Host "  PART 2: DSO360 GLOBAL SCAN EXTRACTION" -ForegroundColor Cyan
    Write-Host "============================================================" -ForegroundColor Cyan

    Write-Host ""
    Write-Host "[DSO360-1] Global summary (scan/summary)..." -ForegroundColor Cyan

    $dso360Summary = $null
    try {
        $dso360Summary = Invoke-Dso360Api `
            -Uri "$($script:BaseUrlDSO360API)/dso-api/v1/sca/scan/summary" `
            -Method "GET" `
            -Headers $Headers

        if ($null -ne $dso360Summary) {
            Write-Host "OK - Global summary retrieved." -ForegroundColor Green
            if ($null -ne $dso360Summary.scannedApps) {
                Write-Host "     Scanned applications (global): $($dso360Summary.scannedApps)" -ForegroundColor Cyan
            }
        }
    }
    catch {
        $script:Stats.Warnings++
        Add-ExecutionEvent -Level "WARN" -Step "DSO360-SUMMARY" -System "DSO360" -Endpoint "/dso-api/v1/sca/scan/summary" -Message $_.Exception.Message
        Write-Warning "WARNING - Error retrieving DSO360 global summary: $_"
    }

    Write-Host ""
    Write-Host "[DSO360-2] Retrieving scanned application list..." -ForegroundColor Cyan

    $allScansDSO360 = @()
    $dsoPage        = 0
    $dsoTotalPages  = 1

    do {
        try {
            Write-Host "  -> Page $($dsoPage + 1)..." -ForegroundColor Yellow

            $uriScans = "{0}/dso-api/v1/sca/projects/scans?page={1}&size={2}" -f $script:BaseUrlDSO360API, $dsoPage, $script:PageSizeDSO360
            $jsonData = Invoke-Dso360Api -Uri $uriScans -Method "GET" -Headers $Headers

            if ($null -ne $jsonData) {
                if ($jsonData.PSObject.Properties.Name -contains "content") {
                    $apps          = $jsonData.content
                    $dsoTotalPages = [int]$jsonData.totalPages
                }
                elseif ($jsonData -is [System.Array]) {
                    $apps          = $jsonData
                    $dsoTotalPages = 1
                }
                elseif ($jsonData.PSObject.Properties.Name -contains "applications") {
                    $apps          = $jsonData.applications
                    $dsoTotalPages = 1
                }
                else {
                    $apps          = @($jsonData)
                    $dsoTotalPages = 1
                }

                $allScansDSO360 += $apps
                $countPage = if ($apps) { @($apps).Count } else { 0 }
                Write-Host "    OK - Page $($dsoPage + 1)/$dsoTotalPages : $countPage item(s)." -ForegroundColor Green
            }

            $dsoPage++
        }
        catch {
            $script:Stats.Warnings++
            Add-ExecutionEvent -Level "WARN" -Step "DSO360-SCANS" -System "DSO360" -Endpoint "/dso-api/v1/sca/projects/scans" -Message "Error on DSO360 page $dsoPage : $($_.Exception.Message)"
            Write-Warning "WARNING - Error on DSO360 page $dsoPage : $_"
            break
        }
    } while ($dsoPage -lt $dsoTotalPages)

    Write-Host ""
    Write-Host "OK - $($allScansDSO360.Count) DSO360 entries retrieved." -ForegroundColor Green

    Write-Host ""
    Write-Host "[DSO360-3] Building DSO360 lookup tables..." -ForegroundColor Cyan

    $dso360MapByCia    = @{}
    $dso360MapByName   = @{}
    $dso360NameKeyList = New-Object System.Collections.Generic.List[string]

    foreach ($scanEntry in $allScansDSO360) {
        try {
            $appName = Get-PropertyValue -Object $scanEntry -PropertyNames @("name","appName","project","applicationName")
            if (-not $appName) { $appName = "N/A" }

            $lastScan = Get-PropertyValue -Object $scanEntry -PropertyNames @("lastScan","lastScanDate","scanDate","updatedAt","last_scan_date")
            $lastScan = if ($lastScan) { Format-ScaScanDate -RawDate "$lastScan" } else { "N/A" }

            $status = Get-PropertyValue -Object $scanEntry -PropertyNames @("status","scanStatus","state")
            if (-not $status) { $status = "N/A" }

            $nbModules = 0
            if ($null -ne $scanEntry.modules) {
                $nbModules = @($scanEntry.modules).Count
            }
            elseif ($null -ne $scanEntry.scans) {
                $nbModules = @($scanEntry.scans).Count
            }

            $scanObj = [PSCustomObject]@{
                CIA       = (Get-PropertyValue -Object $scanEntry -PropertyNames @("cia","CIA"))
                AppName   = $appName
                LastScan  = $lastScan
                Status    = $status
                NbModules = $nbModules
                RawEntry  = $scanEntry
            }

            if ($scanObj.CIA -and -not [string]::IsNullOrWhiteSpace($scanObj.CIA)) {
                $k = "$($scanObj.CIA)".Trim().ToUpperInvariant()
                if (-not $dso360MapByCia.ContainsKey($k)) {
                    $dso360MapByCia[$k] = $scanObj
                }
            }

            if ($appName -ne "N/A") {
                $k = Normalize-Text $appName
                if (-not [string]::IsNullOrWhiteSpace($k)) {
                    if (-not $dso360MapByName.ContainsKey($k)) {
                        $dso360MapByName[$k] = $scanObj
                        [void]$dso360NameKeyList.Add($k)
                    }
                }
            }
        }
        catch {
            $script:Stats.ProcessingErrors++
            Add-ExecutionEvent -Level "WARN" -Step "DSO360-INDEX" -System "DSO360" -Message $_.Exception.Message
        }
    }

    Write-Host "OK - CIA index  : $($dso360MapByCia.Count) entries." -ForegroundColor Green
    Write-Host "     Name index : $($dso360MapByName.Count) entries." -ForegroundColor White

    return [PSCustomObject]@{
        Summary   = $dso360Summary
        AllScans  = $allScansDSO360
        MapByCia  = $dso360MapByCia
        MapByName = $dso360MapByName
        NameKeys  = $dso360NameKeyList
    }
}

# ============================================================
# MATCHING
# ============================================================

function Find-Dso360Match {
    param(
        [Parameter(Mandatory = $true)][object]$DoraApp,
        [Parameter(Mandatory = $true)][hashtable]$MapByCia,
        [Parameter(Mandatory = $true)][hashtable]$MapByName,
        [Parameter(Mandatory = $true)][System.Collections.Generic.List[string]]$NameKeys
    )

    $ciaKey   = if ($DoraApp.cia_key) { "$($DoraApp.cia_key)".Trim().ToUpperInvariant() } else { "" }
    $doraName = Get-ApplicationDisplayName -App $DoraApp
    $nameKey  = Normalize-Text $doraName

    if (-not [string]::IsNullOrWhiteSpace($ciaKey) -and $MapByCia.ContainsKey($ciaKey)) {
        return [PSCustomObject]@{
            Found     = $true
            MatchType = "CIA"
            Match     = $MapByCia[$ciaKey]
        }
    }

    if (-not [string]::IsNullOrWhiteSpace($nameKey) -and $MapByName.ContainsKey($nameKey)) {
        return [PSCustomObject]@{
            Found     = $true
            MatchType = "EXACT_NAME"
            Match     = $MapByName[$nameKey]
        }
    }

    if (-not [string]::IsNullOrWhiteSpace($nameKey)) {
        foreach ($dsoKey in $NameKeys) {
            if (Test-ReasonablePartialMatch -Left $nameKey -Right $dsoKey) {
                return [PSCustomObject]@{
                    Found     = $true
                    MatchType = "PARTIAL_NAME"
                    Match     = $MapByName[$dsoKey]
                }
            }
        }
    }

    return [PSCustomObject]@{
        Found     = $false
        MatchType = "NONE"
        Match     = $null
    }
}

