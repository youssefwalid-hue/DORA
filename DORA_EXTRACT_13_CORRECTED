        try {
            $invokeParams = @{
                Uri         = $uri
                Method      = "GET"
                TimeoutSec  = $TimeoutSec
                ErrorAction = "Stop"
                WebSession  = $script:Session
            }

            if ($PSVersionTable.PSVersion.Major -le 5) {
                $invokeParams["UseBasicParsing"] = $true
            }

            $null = Invoke-WebRequest @invokeParams

            Add-ExecutionEvent -Level "INFO" -Step "PlatformAvailability" -System $PlatformName -Endpoint $uri -Message "Platform is reachable."
