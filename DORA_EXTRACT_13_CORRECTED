function Get-ModuleList {
    param($JsonData)

    if ($null -eq $JsonData) { return @() }

    if ($JsonData.content -is [array] -and $JsonData.content.Count -gt 0) {
        return $JsonData.content
    }
    elseif ($JsonData.modules -is [array] -and $JsonData.modules.Count -gt 0) {
        return $JsonData.modules
    }
    elseif ($JsonData -is [array] -and $JsonData.Count -gt 0) {
        return $JsonData
    }

    return @()
}

function Get-LastScanDate {
    param($Module)

    $candidates = @(
        "lastScanDate","last_scan_date","lastScan",
        "scanDate","scan_date","updatedAt",
        "updated_at","dateLastScan","lastAnalysisDate"
    )

    foreach ($field in $candidates) {
        if ($null -ne $Module -and $Module.PSObject.Properties.Name -contains $field) {
            $value = $Module.$field
            if ($null -ne $value -and $value -ne "") {
                return (Format-ScaScanDate -RawDate "$value")
            }
        }
    }

    return "N/A"
}

function Get-ModuleName {
    param($Module)

    if ($null -eq $Module) { return "Unknown" }
    if ($Module.name)        { return $Module.name }
    if ($Module.moduleName)  { return $Module.moduleName }
    if ($Module.projectName) { return $Module.projectName }
    if ($Module.id)          { return "ID:$($Module.id)" }

    return "Unknown"
}

function Get-Dso360ModulesByCia {
    param(
        [Parameter(Mandatory = $true)][string]$CIA,
        [Parameter(Mandatory = $true)][hashtable]$Headers
    )

    $ciaNormalized = $CIA.Trim().ToUpperInvariant()
    $uri = "{0}/dso-api/v1/sca/projects/scans/{1}?page=0&size={2}" -f $script:BaseUrlDSO360API, $ciaNormalized, $script:PageSizeModules

    $bodyObject = @{
        id         = 0
        type       = $null
        page       = 0
        size       = [int]$script:PageSizeModules
        filtersMap = @{}
    }

    try {
        $jsonData = Invoke-Dso360Api `
            -Uri $uri `
            -Method "POST" `
            -Headers $Headers `
            -Body $bodyObject

        $appNotFound = $false
        if ($null -eq $jsonData) { $appNotFound = $true }
        elseif ($jsonData.PSObject.Properties.Name -contains "error"   -and "$($jsonData.error)"   -match "not found") { $appNotFound = $true }
        elseif ($jsonData.PSObject.Properties.Name -contains "message" -and "$($jsonData.message)" -match "not found") { $appNotFound = $true }
        elseif ($jsonData.PSObject.Properties.Name -contains "status"  -and $jsonData.status -eq 404) { $appNotFound = $true }

        if ($appNotFound) {
            $script:Stats.ModulesNotFound++
            return [PSCustomObject]@{
                CIA            = $ciaNormalized
                Status         = "Not found in DSO360"
                HttpStatus     = 200
                NombreModules  = 0
                Modules        = @()
                LastModuleScan = "N/A"
                Message        = "Application not found in DSO360"
                RawData        = $jsonData
            }
        }

        $listeModules  = Get-ModuleList -JsonData $jsonData
        $nombreModules = @($listeModules).Count

        if ($nombreModules -eq 0) {
            $script:Stats.ModulesEmpty++
            return [PSCustomObject]@{
                CIA            = $ciaNormalized
                Status         = "No modules"
                HttpStatus     = 200
                NombreModules  = 0
                Modules        = @()
                LastModuleScan = "N/A"
                Message        = "0 modules returned by DSO360"
                RawData        = $jsonData
            }
        }

        $modulesFormatted = @()
        $lastScans = @()

        foreach ($module in $listeModules) {
            $moduleName = Get-ModuleName -Module $module
            $lastScan   = Get-LastScanDate -Module $module
            $status     = if ($module.status)  { $module.status }  else { "N/A" }
            $version    = if ($module.version) { $module.version } else { "N/A" }

            if ($lastScan -and $lastScan -ne "N/A") {
                $lastScans += $lastScan
            }

            $modulesFormatted += [PSCustomObject]@{
                Name                    = $moduleName
                Version                 = $version
                ScanStatus              = $status
                DSO360_SCA_Module_Last  = $lastScan
                RawData                 = $module
            }
        }

        $script:Stats.ModulesSuccess++

        return [PSCustomObject]@{
            CIA            = $ciaNormalized
            Status         = "Success"
            HttpStatus     = 200
            NombreModules  = $nombreModules
            Modules        = $modulesFormatted
            LastModuleScan = (Get-LatestFormattedDate -Dates $lastScans)
            Message        = "Success"
            RawData        = $jsonData
        }
    }
    catch {
        $script:Stats.ModuleApiErrors++

        $statusCode   = Get-HttpStatusCodeFromError -ErrorRecord $_
        $errorMessage = $_.Exception.Message
        $responseBody = Get-HttpResponseBodyFromError -ErrorRecord $_

        if (-not [string]::IsNullOrWhiteSpace($responseBody)) {
            $errorMessage = "HTTP code: $statusCode - Detail: $responseBody"
        }

        Add-ExecutionEvent -Level "ERROR" -Step "SCA-MODULES" -System "DSO360" -Endpoint $uri -HttpCode $(if($statusCode){"$statusCode"}else{""}) -Message $errorMessage -Context $ciaNormalized

        if ($statusCode -eq 404) {
            $script:Stats.Modules404++
            return [PSCustomObject]@{
                CIA            = $ciaNormalized
                Status         = "Not found in DSO360"
                HttpStatus     = 404
                NombreModules  = 0
                Modules        = @()
                LastModuleScan = "N/A"
                Message        = "Application not found in DSO360 module SCA scans (HTTP 404)"
                RawData        = $null
            }
        }

        return [PSCustomObject]@{
            CIA            = $ciaNormalized
            Status         = "Error"
            HttpStatus     = if ($statusCode) { $statusCode } else { "N/A" }
            NombreModules  = 0
            Modules        = @()
            LastModuleScan = "N/A"
            Message        = $errorMessage
            RawData        = $responseBody
        }
    }
}

function Get-CheckmarxSastModulesByCia {
    param(
        [Parameter(Mandatory = $true)][string]$CIA,
        [Parameter(Mandatory = $true)][hashtable]$Headers
    )

    $ciaNormalized = $CIA.Trim().ToUpperInvariant()
    $uri = "{0}/dso-api/application/summary/checkmarx/modules/{1}" -f $script:BaseUrlDSO360API, $ciaNormalized

    try {
        $jsonData = Invoke-Dso360Api `
            -Uri $uri `
            -Method "GET" `
            -Headers $Headers

        $appNotFound = $false
        if ($null -eq $jsonData) { $appNotFound = $true }
        elseif ($jsonData.PSObject.Properties.Name -contains "error"   -and "$($jsonData.error)"   -match "not found") { $appNotFound = $true }
        elseif ($jsonData.PSObject.Properties.Name -contains "message" -and "$($jsonData.message)" -match "not found") { $appNotFound = $true }
        elseif ($jsonData.PSObject.Properties.Name -contains "status"  -and $jsonData.status -eq 404) { $appNotFound = $true }

        if ($appNotFound) {
            $script:Stats.SastModulesNotFound++
            return [PSCustomObject]@{
                CIA            = $ciaNormalized
                Status         = "Not found in Checkmarx"
                HttpStatus     = 200
                NombreModules  = 0
                GlobalLastScan = "N/A"
                LastModuleScan = "N/A"
                Modules        = @()
                Message        = "Application not found in Checkmarx"
                RawData        = $jsonData
            }
        }

        $globalLastScan = Get-SastGlobalLastScanDate -Data $jsonData
        $listeModules   = Get-SastModulesList -Data $jsonData

        if ($null -eq $listeModules -or @($listeModules).Count -eq 0) {
            $script:Stats.SastModulesEmpty++
            return [PSCustomObject]@{
                CIA            = $ciaNormalized
                Status         = "No modules"
                HttpStatus     = 200
                NombreModules  = 0
                GlobalLastScan = $globalLastScan
                LastModuleScan = "N/A"
                Modules        = @()
                Message        = "0 modules returned by Checkmarx"
                RawData        = $jsonData
            }
        }

        $modulesFormatted = @()
        $scanDates        = @()

        foreach ($module in $listeModules) {
            $moduleName = Get-SastModuleName -Module $module
            $moduleScan = Get-SastModuleScanDate -Module $module
            $vulns      = Get-SastVulnSummary -Module $module

            if ($moduleScan -and $moduleScan -ne "N/A") {
                $scanDates += $moduleScan
            }

            $modulesFormatted += [PSCustomObject]@{
                Name      = $moduleName
                LastScan  = $moduleScan
                Critical  = [int]$vulns.Critical
                High      = [int]$vulns.High
                Medium    = [int]$vulns.Medium
                Low       = [int]$vulns.Low
                Ignored   = [bool]$vulns.Ignored
                CITools   = [string]$vulns.CITools
                RawData   = $module
            }
        }

        $lastModuleScan = Get-SastLatestDate -Dates $scanDates
        if ($lastModuleScan -eq "N/A" -and $globalLastScan -ne "N/A") {
            $lastModuleScan = $globalLastScan
        }

        $script:Stats.SastModulesSuccess++

        return [PSCustomObject]@{
            CIA            = $ciaNormalized
            Status         = "Success"
            HttpStatus     = 200
            NombreModules  = @($modulesFormatted).Count
            GlobalLastScan = $globalLastScan
            LastModuleScan = $lastModuleScan
            Modules        = $modulesFormatted
            Message        = "Success"
            RawData        = $jsonData
        }
    }
    catch {
        $script:Stats.SastApiErrors++

        $statusCode   = Get-HttpStatusCodeFromError -ErrorRecord $_
        $errorMessage = $_.Exception.Message
        $responseBody = Get-HttpResponseBodyFromError -ErrorRecord $_

        if (-not [string]::IsNullOrWhiteSpace($responseBody)) {
            $errorMessage = "HTTP code: $statusCode - Detail: $responseBody"
        }

        Add-ExecutionEvent -Level "ERROR" -Step "SAST-MODULES" -System "Checkmarx" -Endpoint $uri -HttpCode $(if($statusCode){"$statusCode"}else{""}) -Message $errorMessage -Context $ciaNormalized

        if ($statusCode -eq 404) {
            $script:Stats.Sast404++
            return [PSCustomObject]@{
                CIA            = $ciaNormalized
                Status         = "Not found in Checkmarx"
                HttpStatus     = 404
                NombreModules  = 0
                GlobalLastScan = "N/A"
                LastModuleScan = "N/A"
                Modules        = @()
                Message        = "Application not found in Checkmarx (HTTP 404)"
                RawData        = $null
            }
        }

        return [PSCustomObject]@{
            CIA            = $ciaNormalized
            Status         = "Error"
            HttpStatus     = if ($statusCode) { $statusCode } else { "N/A" }
            NombreModules  = 0
            GlobalLastScan = "N/A"
            LastModuleScan = "N/A"
            Modules        = @()
            Message        = $errorMessage
            RawData        = $responseBody
        }
    }
}

function Get-CachedDso360ModulesByCia {
    param(
        [Parameter(Mandatory = $true)][string]$CIA,
        [Parameter(Mandatory = $true)][hashtable]$Headers
    )

    $key = $CIA.Trim().ToUpperInvariant()

    if ($script:ScaByCiaCache.ContainsKey($key)) {
        $script:Stats.ScaCacheHits++
        return $script:ScaByCiaCache[$key]
    }

    $script:Stats.ScaCacheMisses++
    $result = Get-Dso360ModulesByCia -CIA $key -Headers $Headers
    $script:ScaByCiaCache[$key] = $result
    return $result
