function Decode-JWTInfo {
    param([string]$Token)

    try {
        $parts = $Token.Split(".")
        if ($parts.Count -lt 2) { return $null }

        $payload = $parts[1]
        $padded  = $payload.PadRight($payload.Length + (4 - $payload.Length % 4) % 4, "=")
        $padded  = $padded -replace "-", "+" -replace "_", "/"
        $decoded = $script:Utf8StrictNoBom.GetString([System.Convert]::FromBase64String($padded))
        return (ConvertFrom-JsonUtf8Text -JsonText $decoded)
    }
    catch {
        return $null
    }
}

function Show-TokenInfo {
    param(
        [string]$Token,
        [string]$SystemName
    )

    Write-Host ""
    Write-Host "  Token information [$SystemName]:" -ForegroundColor Cyan

    $jwtData = Decode-JWTInfo -Token $Token
    if ($null -eq $jwtData) {
        Write-Host "  (Unable to decode token information)" -ForegroundColor Gray
        return $true
    }

    if ($jwtData.given_name -and $jwtData.family_name) {
        Write-Host "  User         : $($jwtData.given_name) $($jwtData.family_name)" -ForegroundColor White
    }
    elseif ($jwtData.name) {
        Write-Host "  User         : $($jwtData.name)" -ForegroundColor White
    }
    elseif ($jwtData.preferred_username) {
        Write-Host "  Login        : $($jwtData.preferred_username)" -ForegroundColor White
    }

    if ($jwtData.email) {
        Write-Host "  Email        : $($jwtData.email)" -ForegroundColor White
    }

    if ($jwtData.exp) {
        $expDate   = [System.DateTimeOffset]::FromUnixTimeSeconds([int64]$jwtData.exp).ToLocalTime()
        $now       = [System.DateTimeOffset]::Now
        $remaining = $expDate - $now

        if ($remaining.TotalMinutes -lt 0) {
            Write-Host "  Expiration   : EXPIRED since $([Math]::Abs([int]$remaining.TotalMinutes)) minutes" -ForegroundColor Red
            return $false
        }
        elseif ($remaining.TotalMinutes -lt 10) {
            Write-Host "  Expiration   : in $([int]$remaining.TotalMinutes) min - WARNING almost expired" -ForegroundColor Red
        }
        else {
            Write-Host "  Expiration   : $($expDate.ToString('yyyy-MM-dd HH:mm:ss')) (in $([int]$remaining.TotalHours)h $($remaining.Minutes)min)" -ForegroundColor Green
        }
    }

    return $true
}

function Get-HttpStatusCodeFromError {
    param($ErrorRecord)

    try {
        if ($null -ne $ErrorRecord.Exception.Response) {
            return [int]$ErrorRecord.Exception.Response.StatusCode
        }
    } catch {}
    return $null
}

function Get-HttpResponseBodyFromError {
    param($ErrorRecord)

    try {
        if ($null -ne $ErrorRecord.Exception.Response) {
            $stream = $ErrorRecord.Exception.Response.GetResponseStream()
            if ($null -ne $stream) {
                $contentType = $null
                try { $contentType = [string]$ErrorRecord.Exception.Response.ContentType } catch {}

                $memory = New-Object System.IO.MemoryStream
                try {
                    $stream.CopyTo($memory)
                    return (Convert-HttpBytesToText -Bytes $memory.ToArray() -ContentType $contentType)
                }
                finally {
                    $memory.Dispose()
                }
            }
        }
    } catch {}
    return $null
}

function Test-IsTransientHttpStatus {
    param([Nullable[int]]$StatusCode)

    if ($null -eq $StatusCode) { return $true }
    return ($script:RetryOnStatusCodes -contains [int]$StatusCode)
}

function Get-RetryDelaySeconds {
    param(
        [int]$AttemptNumber,
        [Nullable[int]]$StatusCode = $null
    )

    if ($StatusCode -eq 429) {
        return [Math]::Min(30, ($script:RetryBaseDelaySeconds * $AttemptNumber * 2))
    }

    return [Math]::Min(30, [Math]::Pow(2, [Math]::Max(0, ($AttemptNumber - 1))) * $script:RetryBaseDelaySeconds)
}

function Invoke-ApiRequest {
    param(
        [Parameter(Mandatory = $true)][string[]]$BaseUrls,
        [Parameter(Mandatory = $true)][string]$RelativeUri,
        [ValidateSet("GET","POST")][string]$Method = "GET",
        [hashtable]$Headers,
        [object]$Body = $null,
        [string]$SystemName = "API",
        [string]$Step = "HTTP",
        [switch]$EnableFallback
    )

    $lastError = $null
    $baseUrlIndex = 0

    foreach ($baseUrl in $BaseUrls) {
        $baseUrlIndex++
        $fullUri = "{0}{1}" -f $baseUrl.TrimEnd('/'), $RelativeUri

        if ($baseUrlIndex -gt 1) {
            $script:Stats.FallbackUsed++
            Add-ExecutionEvent -Level "WARN" -Step $Step -System $SystemName -Endpoint $fullUri -Message "Using fallback endpoint base URL."
        }

        for ($attempt = 1; $attempt -le $script:MaxRetryCount; $attempt++) {
            try {
                $invokeParams = @{
                    Uri         = $fullUri
                    Method      = $Method
                    WebSession  = $script:Session
                    Headers     = $Headers
                    TimeoutSec  = $script:RequestTimeoutSec
                    ErrorAction = "Stop"
                }

                if ($Method -eq "POST") {
                    $invokeParams["ContentType"] = $script:ContentType
                    if ($null -ne $Body) {
                        $jsonBody = $Body | ConvertTo-Json -Depth 30 -Compress
                        $invokeParams["Body"] = $script:Utf8NoBom.GetBytes($jsonBody)
                    }
                }

                if ($PSVersionTable.PSVersion.Major -le 5) {
                    $invokeParams["UseBasicParsing"] = $true
                }

                $response = Invoke-WebRequest @invokeParams
                $responseText = Get-WebResponseText -Response $response
                if (-not [string]::IsNullOrWhiteSpace($responseText)) {
                    return (ConvertFrom-JsonUtf8Text -JsonText $responseText)
                }
                return $null
            }
            catch {
                $lastError = $_
                $statusCode = Get-HttpStatusCodeFromError -ErrorRecord $_
                $responseBody = Get-HttpResponseBodyFromError -ErrorRecord $_
                $message = $_.Exception.Message

                if (-not [string]::IsNullOrWhiteSpace($responseBody)) {
                    $message = "{0} | Response: {1}" -f $message, $responseBody
                }

                $isTransient = Test-IsTransientHttpStatus -StatusCode $statusCode
                $isLastAttempt = ($attempt -ge $script:MaxRetryCount)

                Add-ExecutionEvent `
                    -Level $(if ($isTransient -and -not $isLastAttempt) { "WARN" } else { "ERROR" }) `
                    -Step $Step `
                    -System $SystemName `
                    -Endpoint $fullUri `
                    -HttpCode $(if ($statusCode) { "$statusCode" } else { "" }) `
                    -Message ("HTTP attempt {0}/{1} failed: {2}" -f $attempt, $script:MaxRetryCount, $message)

                if ($isTransient -and -not $isLastAttempt) {
                    $script:Stats.RetryCount++
                    $delay = Get-RetryDelaySeconds -AttemptNumber $attempt -StatusCode $statusCode
                    Start-Sleep -Seconds $delay
                    continue
                }

                break
            }
        }

        if (-not $EnableFallback -or $baseUrlIndex -ge $BaseUrls.Count) {
            break
        }
    }

    throw $lastError
}

function Test-PlatformAvailability {
    param(
        [Parameter(Mandatory = $true)][string]$PlatformName,
        [Parameter(Mandatory = $true)][string[]]$BaseUrls,
