function Save-JsonUTF8 {
    param(
        [Parameter(Mandatory = $true)][string]$FilePath,
        [Parameter(Mandatory = $true)][object]$Data
    )

    $cleanData = Repair-MojibakeObject -InputObject $Data
    $json = $cleanData | ConvertTo-Json -Depth 60
    Write-TextFileUtf8 -FilePath $FilePath -Content $json -WithBom
}

function Export-CsvUtf8ExcelCompatible {
    param(
        [Parameter(Mandatory = $true)][object[]]$Rows,
        [Parameter(Mandatory = $true)][string]$FilePath,
        [switch]$UseBomForExcel
    )

    $resolvedPath = Resolve-SafePath -Path $FilePath
    if (Test-Path $resolvedPath) {
        Remove-Item -Path $resolvedPath -Force -ErrorAction SilentlyContinue
    }

    if ($UseBomForExcel) {
        $csv = $Rows | ConvertTo-Csv -NoTypeInformation
        Write-TextFileUtf8 -FilePath $resolvedPath -Content (($csv -join [Environment]::NewLine) + [Environment]::NewLine) -WithBom
    } else {
        $csv = $Rows | ConvertTo-Csv -NoTypeInformation
        Write-TextFileUtf8 -FilePath $resolvedPath -Content (($csv -join [Environment]::NewLine) + [Environment]::NewLine)
    }
}

