function Get-SastModulesList {
    param($Data)

    if ($null -eq $Data) { return $null }
    if ($Data -is [System.Array]) { return $Data }

    $properties = @("modules", "data", "items", "results", "projects", "list", "content", "records")

    foreach ($prop in $properties) {
        if ($Data.PSObject.Properties.Name -contains $prop -and $null -ne $Data.$prop) {
            $val = $Data.$prop
            if ($val -is [System.Array] -and $val.Count -gt 0) {
                return $val
            }
        }
    }

    return $null
}

function Get-SastVulnSummary {
    param($Module)

    $critical = if ($null -ne $Module -and $Module.PSObject.Properties.Name -contains "checkmarxCritical") { $Module.checkmarxCritical } else { 0 }
    $high     = if ($null -ne $Module -and $Module.PSObject.Properties.Name -contains "checkmarxHigh")     { $Module.checkmarxHigh }     else { 0 }
    $medium   = if ($null -ne $Module -and $Module.PSObject.Properties.Name -contains "checkmarxMedium")   { $Module.checkmarxMedium }   else { 0 }
    $low      = if ($null -ne $Module -and $Module.PSObject.Properties.Name -contains "checkmarxLow")      { $Module.checkmarxLow }      else { 0 }
    $ignored  = if ($null -ne $Module -and $Module.PSObject.Properties.Name -contains "ignored")           { $Module.ignored }           else { $false }
    $ciTools  = if ($null -ne $Module -and $Module.PSObject.Properties.Name -contains "ciTools")           { $Module.ciTools }           else { "" }

    return @{
        Critical = $critical
