function Get-MojibakeScore {
    param([AllowNull()][string]$Text)

    if ([string]::IsNullOrEmpty($Text)) { return 0 }

    $patterns = @(
        'Ã[\u0080-\u00BF\u0152\u0153\u0160\u0161\u0178\u017D\u017E\u0192\u02C6\u02DC\u2013\u2014\u2018\u2019\u201A\u201C\u201D\u201E\u2020\u2021\u2022\u2026\u2030\u2039\u203A\u20AC\u2122]',
        'Â(?:[\u0080-\u00BF]|\s)',
        'â(?:[\u0080-\u00BF\u0152\u0153\u0160\u0161\u0178\u017D\u017E\u0192\u02C6\u02DC\u2013\u2014\u2018\u2019\u201A\u201C\u201D\u201E\u2020\u2021\u2022\u2026\u2030\u2039\u203A\u20AC\u2122]){1,2}',
        'ï»¿',
        'ðŸ'
    )

    $score = 0
    foreach ($pattern in $patterns) {
        $score += [System.Text.RegularExpressions.Regex]::Matches($Text, $pattern).Count
    }

    return $score
}

function Repair-MojibakeString {
    param([AllowNull()][string]$Text)

    if ([string]::IsNullOrEmpty($Text)) { return $Text }

    $current = $Text

    for ($pass = 0; $pass -lt 3; $pass++) {
        $currentScore = Get-MojibakeScore -Text $current
        if ($currentScore -eq 0) { break }

        $repairedThisPass = $false

        foreach ($sourceCodePage in @(1252, 28591)) {
            try {
                $sourceEncoding = [System.Text.Encoding]::GetEncoding(
                    $sourceCodePage,
                    [System.Text.EncoderFallback]::ExceptionFallback,
                    [System.Text.DecoderFallback]::ExceptionFallback
                )
                $candidateBytes = $sourceEncoding.GetBytes($current)
                $candidate = $script:Utf8StrictNoBom.GetString($candidateBytes)
                $candidateScore = Get-MojibakeScore -Text $candidate

                if ($candidateScore -lt $currentScore) {
                    $current = $candidate
                    $repairedThisPass = $true
                    break
                }
            }
            catch {}
        }

        if ($repairedThisPass) { continue }

        break
    }

    $knownFragments = [ordered]@{
        "â€™" = "’"
        "â€˜" = "‘"
        "â€œ" = "“"
        "â€" = "”"
        "â€“" = "–"
        "â€”" = "—"
        "â€¦" = "…"
        "â€¢" = "•"
        "â€ž" = "„"
        "â€š" = "‚"
    }

    foreach ($fragment in $knownFragments.Keys) {
        $current = $current.Replace($fragment, $knownFragments[$fragment])
    }

    $current = $current.Replace("â€", '"')

    return $current
}

function Repair-MojibakeObject {
    param([AllowNull()]$InputObject)

    if ($null -eq $InputObject) { return $null }

    if ($InputObject -is [string]) {
        return (Repair-MojibakeString -Text $InputObject)
    }

    if ($InputObject -is [System.Collections.IDictionary]) {
        foreach ($key in @($InputObject.Keys)) {
            $InputObject[$key] = Repair-MojibakeObject -InputObject $InputObject[$key]
        }
        return $InputObject
    }

    if ($InputObject -is [System.Collections.IList]) {
        for ($index = 0; $index -lt $InputObject.Count; $index++) {
            $InputObject[$index] = Repair-MojibakeObject -InputObject $InputObject[$index]
        }
        return $InputObject
    }

    if ($InputObject -is [System.Management.Automation.PSCustomObject]) {
        foreach ($property in @($InputObject.PSObject.Properties)) {
            try {
                $property.Value = Repair-MojibakeObject -InputObject $property.Value
            }
            catch {
                # Encoding-only safeguard: leave read-only or ambiguous properties unchanged.
            }
        }
        return $InputObject
    }

    return $InputObject
}

function ConvertFrom-JsonUtf8Text {
    param([Parameter(Mandatory = $true)][string]$JsonText)

    $cleanJson = $JsonText.TrimStart([char]0xFEFF)
    $data = $cleanJson | ConvertFrom-Json
    return (Repair-MojibakeObject -InputObject $data)
}

function Get-CharsetEncoding {
    param([AllowNull()][string]$ContentType)

    if ([string]::IsNullOrWhiteSpace($ContentType)) { return $null }

    $match = [System.Text.RegularExpressions.Regex]::Match(
        $ContentType,
        'charset\s*=\s*["'']?([^;"''\s]+)',
        [System.Text.RegularExpressions.RegexOptions]::IgnoreCase
    )

    if (-not $match.Success) { return $null }

    try {
        return [System.Text.Encoding]::GetEncoding($match.Groups[1].Value.Trim())
    }
    catch {
        return $null
    }
}

function Convert-HttpBytesToText {
    param(
        [Parameter(Mandatory = $true)][byte[]]$Bytes,
        [AllowNull()][string]$ContentType
    )

    if ($Bytes.Length -eq 0) { return "" }

    if ($Bytes.Length -ge 3 -and $Bytes[0] -eq 0xEF -and $Bytes[1] -eq 0xBB -and $Bytes[2] -eq 0xBF) {
        return (Repair-MojibakeString -Text $script:Utf8NoBom.GetString($Bytes, 3, $Bytes.Length - 3))
    }

    $declaredEncoding = Get-CharsetEncoding -ContentType $ContentType
    $utf8Text = $null
    $utf8IsValid = $false

    try {
        $utf8Text = $script:Utf8StrictNoBom.GetString($Bytes)
        $utf8IsValid = $true
    }
    catch {}

    if ($utf8IsValid -and $ContentType -match '(?i)application/(?:[^;]+\+)?json') {
        return (Repair-MojibakeString -Text $utf8Text.TrimStart([char]0xFEFF))
    }

    if ($null -ne $declaredEncoding) {
        try {
            $declaredText = $declaredEncoding.GetString($Bytes)

            if ($declaredEncoding.WebName -match '^utf-?8$') {
                return (Repair-MojibakeString -Text $declaredText.TrimStart([char]0xFEFF))
            }

            if ($utf8IsValid -and (Get-MojibakeScore -Text $declaredText) -gt (Get-MojibakeScore -Text $utf8Text)) {
                return (Repair-MojibakeString -Text $utf8Text.TrimStart([char]0xFEFF))
            }

            return (Repair-MojibakeString -Text $declaredText.TrimStart([char]0xFEFF))
        }
        catch {}
    }

    if ($utf8IsValid) {
        return (Repair-MojibakeString -Text $utf8Text.TrimStart([char]0xFEFF))
    }

    $windows1252 = [System.Text.Encoding]::GetEncoding(1252)
    return (Repair-MojibakeString -Text $windows1252.GetString($Bytes))
}

function Get-WebResponseText {
    param([Parameter(Mandatory = $true)]$Response)

    $contentType = $null
    try { $contentType = [string]$Response.Headers['Content-Type'] } catch {}

    try {
        if ($null -ne $Response.RawContentStream) {
            $stream = $Response.RawContentStream
            if ($stream.CanSeek) { $stream.Position = 0 }

            $memory = New-Object System.IO.MemoryStream
            try {
                $stream.CopyTo($memory)
                return (Convert-HttpBytesToText -Bytes $memory.ToArray() -ContentType $contentType)
            }
            finally {
                $memory.Dispose()
            }
        }
    }
    catch {}

    return (Repair-MojibakeString -Text ([string]$Response.Content))
}

function Resolve-SafePath {
    param([Parameter(Mandatory = $true)][string]$Path)

    try {
        if ([System.IO.Path]::IsPathRooted($Path)) {
            return $Path
        }

        $clean = $Path -replace '^\.[\\/]', ''
        return (Join-Path -Path (Get-Location).Path -ChildPath $clean)
    } catch {
        return $Path
    }
}

function Write-TextFileUtf8 {
    param(
        [Parameter(Mandatory = $true)][string]$FilePath,
        [Parameter(Mandatory = $true)][string]$Content,
        [switch]$Append,
        [switch]$WithBom
    )

    $resolvedPath = Resolve-SafePath -Path $FilePath
    $encoding = if ($WithBom) { $script:Utf8Bom } else { $script:Utf8NoBom }
    $safeContent = Repair-MojibakeString -Text $Content

    if ($Append -and (Test-Path $resolvedPath)) {
        [System.IO.File]::AppendAllText($resolvedPath, $safeContent, $encoding)
    } else {
        [System.IO.File]::WriteAllText($resolvedPath, $safeContent, $encoding)
    }
}

function Add-ExecutionEvent {
    param(
        [Parameter(Mandatory = $true)][ValidateSet("INFO","WARN","ERROR")] [string]$Level,
        [Parameter(Mandatory = $true)][string]$Step,
        [Parameter(Mandatory = $true)][string]$Message,
        [string]$Endpoint = "",
        [string]$HttpCode = "",
        [string]$System = "",
        [string]$Context = ""
    )

    $Step     = Repair-MojibakeString -Text $Step
    $Message  = Repair-MojibakeString -Text $Message
    $Endpoint = Repair-MojibakeString -Text $Endpoint
    $System   = Repair-MojibakeString -Text $System
    $Context  = Repair-MojibakeString -Text $Context

    $event = [PSCustomObject]@{
        Timestamp = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
        Level     = $Level
        Step      = $Step
        System    = $System
        Endpoint  = $Endpoint
        HttpCode  = $HttpCode
        Context   = $Context
        Message   = $Message
    }

    $script:ExecutionEvents.Add($event)

    $line = "[{0}] [{1}] [{2}] [System={3}] [Http={4}] [Endpoint={5}] {6}" -f `
        $event.Timestamp, $event.Level, $event.Step, `
        $(if($event.System){$event.System}else{"N/A"}), `
        $(if($event.HttpCode){$event.HttpCode}else{"N/A"}), `
        $(if($event.Endpoint){$event.Endpoint}else{"N/A"}), `
        $event.Message

    Write-TextFileUtf8 -FilePath $script:LogPath -Content ($line + [Environment]::NewLine) -Append
}

