function Get-BearerToken {
    param(
        [string]$SystemName,
        [string]$SystemUrl,
        [string]$Instructions,
        [switch]$OpenBrowser
    )

    if ($OpenBrowser) {
        try {
            Start-Process $SystemUrl | Out-Null
            Add-ExecutionEvent -Level "INFO" -Step "Authentication" -System $SystemName -Message "Browser opened for initial token retrieval."
        }
        catch {
            Add-ExecutionEvent -Level "WARN" -Step "Authentication" -System $SystemName -Message "Unable to open browser automatically."
        }
    }

    $token       = ""
    $attempt     = 0
    $maxAttempts = 3

    while ($token -eq "" -and $attempt -lt $maxAttempts) {
        $attempt++

        Write-Host "Paste the full Authorization token (Bearer eyJ...):" -ForegroundColor White
        Write-Host "(The token will not be displayed on screen for security reasons)" -ForegroundColor Gray
        Write-Host ""

        $secureToken = Read-Host -AsSecureString "Token $SystemName"

        $bstr = [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($secureToken)
        try {
            $tokenPlain = [System.Runtime.InteropServices.Marshal]::PtrToStringBSTR($bstr)
        }
        finally {
            if ($bstr -ne [IntPtr]::Zero) {
                [System.Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr)
            }
        }

        $tokenPlain = $tokenPlain.Trim()
        $tokenPlain = $tokenPlain -replace "[\r\n]", ""

        if ($tokenPlain -match "^(?i)Bearer\s+(.+)$") {
            $tokenPlain = $Matches[1].Trim()
        }

        if ([string]::IsNullOrWhiteSpace($tokenPlain)) {
            Write-Warning "Empty token. Please try again."
            Add-ExecutionEvent -Level "WARN" -Step "Authentication" -System $SystemName -Message "Empty token entered by user."
            continue
        }

        $token = $tokenPlain

        $valid = Show-TokenInfo -Token $token -SystemName $SystemName
        if ($valid -eq $false) {
            Write-Warning "Expired token. Please obtain a new token and try again."
            Add-ExecutionEvent -Level "WARN" -Step "Authentication" -System $SystemName -Message "Expired token detected locally from JWT payload."
            $token = ""
        }
    }

    if ($token -eq "") {
        Write-Error "ERROR - Token [$SystemName] invalid after $maxAttempts attempts."
        Add-ExecutionEvent -Level "ERROR" -Step "Authentication" -System $SystemName -Message "Token acquisition failed after maximum attempts."
        exit 1
    }

    return $token
}

function Get-ValidatedBearerToken {
    param(
        [Parameter(Mandatory = $true)][string]$SystemName,
        [Parameter(Mandatory = $true)][string]$SystemUrl,
        [Parameter(Mandatory = $true)][string]$Instructions,
        [Parameter(Mandatory = $true)][scriptblock]$HeaderFactory,
        [Parameter(Mandatory = $true)][scriptblock]$TokenValidator,
        [int]$MaxValidationAttempts = 3
    )

    for ($attempt = 1; $attempt -le $MaxValidationAttempts; $attempt++) {
        Write-Host ""
        Write-Host "============================================================" -ForegroundColor Cyan
        Write-Host " TOKEN ACQUISITION + VALIDATION [$SystemName] - Attempt $attempt / $MaxValidationAttempts" -ForegroundColor Cyan
        Write-Host "============================================================" -ForegroundColor Cyan

        $openBrowserThisTime = ($attempt -eq 1)

        $token = Get-BearerToken `
            -SystemName $SystemName `
            -SystemUrl $SystemUrl `
            -Instructions $Instructions `
            -OpenBrowser:($openBrowserThisTime)

        $headers = & $HeaderFactory $token
        $isValid = & $TokenValidator $headers

        if ($isValid) {
            Write-Host "OK - Valid token confirmed for [$SystemName]." -ForegroundColor Green
            Add-ExecutionEvent -Level "INFO" -Step "AuthenticationValidation" -System $SystemName -Message "Valid token confirmed."
            return $token
        }

        Write-Host ""
        Write-Host "WARNING - Invalid or rejected token for [$SystemName]." -ForegroundColor Yellow

        if ($attempt -lt $MaxValidationAttempts) {
            Write-Host "Please paste a new token." -ForegroundColor Yellow
        }

        Add-ExecutionEvent -Level "WARN" -Step "AuthenticationValidation" -System $SystemName -Message "Token validation failed on attempt $attempt."
    }

    Add-ExecutionEvent -Level "ERROR" -Step "AuthenticationValidation" -System $SystemName -Message "Maximum token validation attempts reached."
    Write-Host "ERROR - Unable to validate a token for [$SystemName] after $MaxValidationAttempts attempts." -ForegroundColor Red
    exit 1
}

