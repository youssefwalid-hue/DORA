function Get-NormalizedTokens {
    param([string]$Text)

    $normalized = Normalize-Text $Text
    if ([string]::IsNullOrWhiteSpace($normalized)) { return @() }

    $tokens = $normalized -split '\s+'
    $tokens = $tokens | Where-Object { $_ -and $_.Length -ge 3 } | Select-Object -Unique
    return @($tokens)
}

function Test-ReasonablePartialMatch {
    param(
        [string]$Left,
        [string]$Right
    )

    $leftNorm  = Normalize-Text $Left
    $rightNorm = Normalize-Text $Right

    if ([string]::IsNullOrWhiteSpace($leftNorm) -or [string]::IsNullOrWhiteSpace($rightNorm)) {
        return $false
    }

    if ($leftNorm.Length -lt 6 -or $rightNorm.Length -lt 6) {
        return $false
    }

    $lenRatio = [Math]::Min($leftNorm.Length, $rightNorm.Length) / [Math]::Max($leftNorm.Length, $rightNorm.Length)
    if ($lenRatio -lt 0.45) {
        return $false
    }

    if ($leftNorm -eq $rightNorm) {
        return $true
    }

    if ($leftNorm -like "*$rightNorm*" -or $rightNorm -like "*$leftNorm*") {
        return $true
    }

    $leftTokens  = Get-NormalizedTokens -Text $leftNorm
    $rightTokens = Get-NormalizedTokens -Text $rightNorm

    if ($leftTokens.Count -eq 0 -or $rightTokens.Count -eq 0) {
        return $false
    }

    $common = @($leftTokens | Where-Object { $rightTokens -contains $_ })
    if ($common.Count -ge 2) {
        return $true
    }

    return $false
}

