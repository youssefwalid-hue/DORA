 "
 # ─────────────────────────────────────────────────────────────
# Forcer l'encodage UTF-8 pour la console
# ─────────────────────────────────────────────────────────────
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
$OutputEncoding = [System.Text.Encoding]::UTF8
chcp 65001 | Out-Null

# ─────────────────────────────────────────────────────────────
# 1. Lecture de la liste des CIA en entrée
# ─────────────────────────────────────────────────────────────
Write-Host ""
Write-Host "Entrez les codes CIA separes par des virgules, espaces ou point-virgules :" -ForegroundColor Cyan
Write-Host ""
$inputCIA = Read-Host "CIA"

if ([string]::IsNullOrWhiteSpace($inputCIA)) {
    Write-Host "Aucune CIA saisie. Fin du script." -ForegroundColor Red
    exit
}

$applications = $inputCIA -split '[,;\s]+' `
    | Where-Object { $_ -ne "" } `
    | ForEach-Object { $_.Trim().ToUpper() }

$totalApplications = $applications.Count
Write-Host "-> $totalApplications application(s) chargee(s)" -ForegroundColor DarkGray

# ─────────────────────────────────────────────────────────────
# Paramètres généraux
# ─────────────────────────────────────────────────────────────
$defaultSize      = 500
$token            = "Bearer BajiYyZjdYhUkqnypvQT7t2Lffm1UWbnFaQPcKDZHOH4tW9Xh6nTN6"
$fichierSortie    = "./resultats_applications.json"
$fichierSortieCsv = "./resultats_modules.csv"

# ─────────────────────────────────────────────────────────────
# Configuration session HTTP
# ─────────────────────────────────────────────────────────────
$session = New-Object Microsoft.PowerShell.Commands.WebRequestSession
$session.UserAgent = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36"

$headers = @{
    "Accept"             = "application/json, text/plain, */*"
    "Accept-Encoding"    = "gzip, deflate, br, zstd"
    "Accept-Language"    = "fr-FR,fr;q=0.9,en-US;q=0.8,en;q=0.7"
    "Authorization"      = $token
    "Origin"             = "https://dso360.mycloud.intranatixis.com"
    "Referer"            = "https://dso360.mycloud.intranatixis.com/"
    "Sec-Fetch-Dest"     = "empty"
    "Sec-Fetch-Mode"     = "cors"
    "Sec-Fetch-Site"     = "same-site"
    "X-Requested-With"   = "XMLHttpRequest"
    "sec-ch-ua"          = "`"Not;A=Brand`";v=`"8`", `"Chromium`";v=`"150`", `"Google Chrome`";v=`"150`""
    "sec-ch-ua-mobile"   = "?0"
    "sec-ch-ua-platform" = "`"Windows`""
}

# ─────────────────────────────────────────────────────────────
# Tableaux de résultats
# ─────────────────────────────────────────────────────────────
$resultatsGlobaux = @()
$tousLesModules   = @()

# ─────────────────────────────────────────────────────────────
# Fonction : extrait la liste des modules
# ─────────────────────────────────────────────────────────────
function Get-ModuleList {
    param($jsonData)
    if (-not $jsonData) { return @() }
    if ($jsonData.content -is [array] -and $jsonData.content.Count -gt 0) { return $jsonData.content }
    elseif ($jsonData.modules -is [array] -and $jsonData.modules.Count -gt 0) { return $jsonData.modules }
    elseif ($jsonData -is [array] -and $jsonData.Count -gt 0) { return $jsonData }
    else { return @() }
}

# ─────────────────────────────────────────────────────────────
# Fonction : récupère la date de dernier scan
# ─────────────────────────────────────────────────────────────
function Get-LastScanDate {
    param($module)
    $candidats = @(
        "lastScanDate","last_scan_date","lastScan",
        "scanDate","scan_date","updatedAt",
        "updated_at","dateLastScan","lastAnalysisDate"
    )
    foreach ($champ in $candidats) {
        $valeur = $module.$champ
        if ($null -ne $valeur -and $valeur -ne "") { return $valeur }
    }
    return "N/A"
}

# ─────────────────────────────────────────────────────────────
# Fonction : récupère le nom du module
# ─────────────────────────────────────────────────────────────
function Get-ModuleName {
    param($module)
    if ($module.name)        { return $module.name }
    if ($module.moduleName)  { return $module.moduleName }
    if ($module.projectName) { return $module.projectName }
    if ($module.id)          { return "ID:$($module.id)" }
    return "Inconnu"
}

# ─────────────────────────────────────────────────────────────
# 2. Boucle principale
# ─────────────────────────────────────────────────────────────
$compteur = 0

foreach ($cia in $applications) {
    $compteur++
    $ratio = "[$compteur/$totalApplications]"

    # Affichage de la progression sur une seule ligne (début)
    Write-Host ""
    Write-Host "$ratio Verification et Extraction de module(s) depuis   " `
        -ForegroundColor Cyan -NoNewline
    Write-Host "$cia" -ForegroundColor White -NoNewline
    Write-Host "  ==>  " -ForegroundColor Cyan -NoNewline

    $uri = "https://tes.mycloud.intranatixis.com/dso-api/v1/sca/projects/scans/${cia}?page=0&size=${defaultSize}"

    $bodyObject = @{
        id         = 0
        type       = $null
        page       = 0
        size       = [int]$defaultSize
        filtersMap = @{}
    }
    $bodyJson = $bodyObject | ConvertTo-Json -Compress

    try {
        $response = Invoke-WebRequest -UseBasicParsing -Uri $uri `
            -Method "POST" `
            -WebSession $session `
            -Headers $headers `
            -ContentType "application/json" `
            -Body $bodyJson

        $jsonData = $response.Content | ConvertFrom-Json

        # ── Détection application inexistante (réponse API) ──
        $appInexistante = $false
        if ($null -eq $jsonData) { $appInexistante = $true }
        elseif ($jsonData.PSObject.Properties.Name -contains "error"   -and $jsonData.error   -match "not found") { $appInexistante = $true }
        elseif ($jsonData.PSObject.Properties.Name -contains "message" -and $jsonData.message -match "not found") { $appInexistante = $true }
        elseif ($jsonData.PSObject.Properties.Name -contains "status"  -and $jsonData.status  -eq 404)            { $appInexistante = $true }

        if ($appInexistante) {
            Write-Host "Application inexistante sur les SCANs du module SCA" -ForegroundColor DarkYellow
            $resultatsGlobaux += [PSCustomObject]@{
                CIA           = $cia
                Statut        = "Non existante dans DSO360"
                Date          = (Get-Date -Format "yyyy-MM-dd HH:mm:ss")
                NombreModules = 0
                Modules       = @()
                Donnees       = "Application non existante dans DSO360"
            }
            continue
        }

        # ── Extraction des modules ───────────────────────────
        $listeModules  = Get-ModuleList -jsonData $jsonData
        $nombreModules = $listeModules.Count

        # ── Résultat sur la même ligne ───────────────────────
        if ($nombreModules -eq 0) {
            # 0 module = inexistante sur les SCANs SCA
            Write-Host "Application inexistante sur les SCANs du module SCA" -ForegroundColor DarkYellow

            $resultatsGlobaux += [PSCustomObject]@{
                CIA           = $cia
                Statut        = "Non existante dans DSO360"
                Date          = (Get-Date -Format "yyyy-MM-dd HH:mm:ss")
                NombreModules = 0
                Modules       = @()
                Donnees       = $jsonData
            }
            continue
        }
        else {
            Write-Host "Succes !  $nombreModules module(s) trouve(s)" -ForegroundColor Green
        }

        # ── Construction des modules formatés ───────────────
        $modulesFormatted = @()

        foreach ($module in $listeModules) {
            $nomModule = Get-ModuleName   -module $module
            $lastScan  = Get-LastScanDate -module $module

            $tousLesModules += [PSCustomObject]@{
                CIA          = $cia
                NomModule    = $nomModule
                LastScanDate = $lastScan
                Status       = if ($module.status)  { $module.status }  else { "N/A" }
                Version      = if ($module.version) { $module.version } else { "N/A" }
            }

            $modulesFormatted += [PSCustomObject]@{
                Nom          = $nomModule
                LastScanDate = $lastScan
                RawData      = $module
            }
        }

        $resultatsGlobaux += [PSCustomObject]@{
            CIA           = $cia
            Statut        = "Succes"
            Date          = (Get-Date -Format "yyyy-MM-dd HH:mm:ss")
            NombreModules = $nombreModules
            Modules       = $modulesFormatted
            Donnees       = $jsonData
        }
    }
    catch {
        $statusCode   = $null
        $errorMessage = $_.Exception.Message

        if ($_.Exception.Response) {
            $statusCode = [int]$_.Exception.Response.StatusCode
            try {
                $reader       = New-Object System.IO.StreamReader($_.Exception.Response.GetResponseStream())
                $responseBody = $reader.ReadToEnd()
                $errorMessage = "Code HTTP: $statusCode - Detail: $responseBody"
            } catch {}
        }

        if ($statusCode -eq 404) {
            Write-Host "Application inexistante sur les SCANs du module SCA  (HTTP 404)" -ForegroundColor DarkYellow
            $resultatsGlobaux += [PSCustomObject]@{
                CIA           = $cia
                Statut        = "Non existante dans DSO360"
                Date          = (Get-Date -Format "yyyy-MM-dd HH:mm:ss")
                NombreModules = 0
                Modules       = @()
                Donnees       = "Application non existante dans DSO360"
            }
        }
        else {
            Write-Host "Erreur  =>  $errorMessage" -ForegroundColor Red
            $resultatsGlobaux += [PSCustomObject]@{
                CIA           = $cia
                Statut        = "Erreur"
                Date          = (Get-Date -Format "yyyy-MM-dd HH:mm:ss")
                NombreModules = 0
                Modules       = @()
                Donnees       = $errorMessage
            }
        }
    }
}

# ─────────────────────────────────────────────────────────────
# 3. Export JSON
# ─────────────────────────────────────────────────────────────
Write-Host ""
Write-Host "Sauvegarde JSON -> $fichierSortie ..." -ForegroundColor Green
$resultatsGlobaux | ConvertTo-Json -Depth 15 | Out-File -FilePath $fichierSortie -Encoding utf8

