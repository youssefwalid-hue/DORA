            DSO360_AppName    = "Nom de l'application dans DSO360"
            DSO360_LastScan   = "Date du dernier scan SCA"
            DSO360_ScanStatus = "Statut du dernier scan"
            DSO360_NbModules  = "Nombre de modules scannes"
        }
    }

    # TOUTES les applications DORA enrichies
    Applications = $enrichedAppsDORA
}

try {
