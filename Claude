}
Write-Host ""
Write-Host "  [DSO360]" -ForegroundColor Cyan
Write-Host "  Total scans recuperes                 : $($allScansDSO360.Count)" -ForegroundColor White
Write-Host "  Index CIA                             : $($dso360MapByCia.Count)" -ForegroundColor White
Write-Host "  Index Nom                             : $($dso360MapByName.Count)" -ForegroundColor White
Write-Host ""
Write-Host "  [ENRICHISSEMENT DSO360]" -ForegroundColor Cyan
Write-Host "  Apps DEV enrichies avec DSO360        : $devAppsCount" -ForegroundColor White
Write-Host "  Apps non-DEV (champs DSO360 = N/A)   : $nonDevCount" -ForegroundColor White
Write-Host "  DEV avec scan DSO360 (MATCH)          : $matchedCount" -ForegroundColor Green
Write-Host "  DEV sans scan DSO360 (NO MATCH)       : $unmatchedCount" -ForegroundColor Yellow
