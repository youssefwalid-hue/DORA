$naturesConfig = @(
    @{
        code       = "DEV"
        labelEn    = "Specific development"
        labelFr    = "D$([char]233)veloppement sp$([char]233)cifique"
        legacyCode = "D$([char]233)veloppement Sp$([char]233)cifique"
        body       = $bodyNatureDEV
    },
    @{
        code       = "NOC"
        labelEn    = "Not Concerned"
        labelFr    = "Non Concern$([char]233)"
        legacyCode = "Non Concern$([char]233)"
        body       = $bodyNatureNOC
    },
    @{
        code       = "SFT"
        labelEn    = "Software package"
        labelFr    = "Progiciel"
        legacyCode = "Progiciel"
        body       = $bodyNatureSFT
    },
    @{
        code       = "SPE"
        labelEn    = "Service provided by external supplier"
        labelFr    = "Service fourni par un prestataire externe"
        legacyCode = "Service Prestataire Ext"
        body       = $bodyNatureSPE
    }
)

foreach ($nat in $naturesConfig) {
    Write-Host "  -> Nature [$($nat.code)] $($nat.labelEn)..." -ForegroundColor Yellow

    try {
        $natResponse = Invoke-WebRequest -UseBasicParsing `
            -Uri "$baseUrlDORA/api/application/search" `
            -Method "POST" `
            -WebSession $session `
            -Headers $headersDORA `
            -ContentType $contentType `
            -Body $nat.body

        $natData = $natResponse.Content | ConvertFrom-Json
        $natList = if ($natData -is [Array])           { $natData }
                   elseif ($null -ne $natData.results) { $natData.results }
                   else                                { $natData }

        $count = 0
        foreach ($app in $natList) {

            # Cle unique = cia
            $ciaKey = if ($app.cia) { $app.cia } else { $app.groupId }
            if ([string]::IsNullOrWhiteSpace($ciaKey)) { continue }

            if (-not $appNaturesMap.ContainsKey($ciaKey)) {
                $appNaturesMap[$ciaKey] = [System.Collections.Generic.List[object]]::new()
            }

            # On conserve les libelles tels que recuperes depuis le referentiel
            $appNaturesMap[$ciaKey].Add([PSCustomObject]@{
                code       = $nat.code
                labelEn    = $nat.labelEn
                labelFr    = $nat.labelFr
                legacyCode = $nat.legacyCode
            })
            $count++
        }
        Write-Host "     OK - $count application(s) trouvees." -ForegroundColor Green
    }
    catch {
        Write-Warning "     ATTENTION - Erreur [$($nat.code)] : $_"
    }
}

$appsWithNature    = ($appNaturesMap.Keys | Measure-Object).Count
$appsWithoutNature = $allAppsDORA.Count - $appsWithNature

Write-Host ""
Write-Host "  Resume natures :" -ForegroundColor Cyan
Write-Host "  -> $appsWithNature avec nature identifiee" -ForegroundColor White
Write-Host "  -> $appsWithoutNature sans nature identifiee" -ForegroundColor White

# ----------------------------------------------------------
# DORA - ETAPE 4 : Fusion DORA + natures
# ----------------------------------------------------------
Write-Host ""
Write-Host "[DORA-4] Fusion des donnees DORA + natures..." -ForegroundColor Cyan

$enrichedAppsDORA = [System.Collections.Generic.List[object]]::new()

foreach ($app in $allAppsDORA) {

    # Cle unique = cia (fallback groupId)
    $ciaKey = if ($app.cia) { $app.cia } else { $app.groupId }

    # Recuperation des natures depuis la map
    if (-not [string]::IsNullOrWhiteSpace($ciaKey) -and $appNaturesMap.ContainsKey($ciaKey)) {

        $naturesFound = $appNaturesMap[$ciaKey]
        $codes        = ($naturesFound | ForEach-Object { $_.code })    -join " | "
        $labelsEn     = ($naturesFound | ForEach-Object { $_.labelEn }) -join " | "
        $labelsFr     = ($naturesFound | ForEach-Object { $_.labelFr }) -join " | "

        $criteriaValue = [PSCustomObject]@{
            isCurrentVersion = $true
            natures          = $naturesFound
            hasNature        = $true
            natureSummary    = [PSCustomObject]@{
                codes    = $codes
                labelsEn = $labelsEn
                labelsFr = $labelsFr
            }
        }
    }
    else {
        $criteriaValue = [PSCustomObject]@{
            isCurrentVersion = $true
            natures          = @()
            hasNature        = $false
            natureSummary    = [PSCustomObject]@{
                codes    = ""
                labelsEn = "No development nature identified"
                labelsFr = "Aucune nature de developpement identifiee"
            }
        }
    }

    # On conserve TOUTES les donnees brutes DORA
    # et on ajoute/ecrase uniquement le champ characteristicCriteria
    $enrichedApp = $app | ConvertTo-Json -Depth 10 | ConvertFrom-Json
    $enrichedApp | Add-Member -NotePropertyName "cia_key"               -NotePropertyValue $ciaKey        -Force
    $enrichedApp | Add-Member -NotePropertyName "characteristicCriteria" -NotePropertyValue $criteriaValue -Force
    $enrichedApp | Add-Member -NotePropertyName "extractionDate"         -NotePropertyValue (Get-Date -Format "yyyy-MM-dd HH:mm:ss") -Force

    # Champs DSO360 initialises a N/A pour toutes les apps
    # (seront mis a jour pour les apps DEV dans la partie 3)
    $enrichedApp | Add-Member -NotePropertyName "DSO360_Matched"   -NotePropertyValue "N/A" -Force
    $enrichedApp | Add-Member -NotePropertyName "DSO360_MatchType"  -NotePropertyValue "N/A" -Force
    $enrichedApp | Add-Member -NotePropertyName "DSO360_AppName"    -NotePropertyValue "N/A" -Force
    $enrichedApp | Add-Member -NotePropertyName "DSO360_LastScan"   -NotePropertyValue "N/A" -Force
    $enrichedApp | Add-Member -NotePropertyName "DSO360_ScanStatus" -NotePropertyValue "N/A" -Force
    $enrichedApp | Add-Member -NotePropertyName "DSO360_NbModules"  -NotePropertyValue "N/A" -Force
    $enrichedApp | Add-Member -NotePropertyName "DSO360_RawEntry"   -NotePropertyValue $null -Force

    $enrichedAppsDORA.Add($enrichedApp)
}

Write-Host "OK - $($enrichedAppsDORA.Count) applications DORA enrichies avec natures." -ForegroundColor Green

# ============================================================
# PARTIE 2 : EXTRACTION DES SCANS DSO360
# ============================================================
Write-Host ""
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "  PARTIE 2 : EXTRACTION DES SCANS DSO360" -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan

# ----------------------------------------------------------
# DSO360 - ETAPE 1 : Resume global
# ----------------------------------------------------------
Write-Host ""
Write-Host "[DSO360-1] Resume global (scan/summary)..." -ForegroundColor Cyan

$dso360Summary = $null

try {
    $responseSummary = Invoke-WebRequest -UseBasicParsing `
        -Uri "$baseUrlDSO360API/dso-api/v1/sca/scan/summary" `
        -WebSession $session `
        -Headers $headersDSO360

    if ($responseSummary.Content) {
        $dso360Summary = $responseSummary.Content | ConvertFrom-Json
        Write-Host "OK - Statut HTTP : $($responseSummary.StatusCode)" -ForegroundColor Green
        if ($null -ne $dso360Summary.scannedApps) {
            Write-Host "     Applications scannees (global) : $($dso360Summary.scannedApps)" -ForegroundColor Cyan
        }
    }
}
catch {
    Write-Warning "ATTENTION - Erreur resume global DSO360 : $_"
}

# ----------------------------------------------------------
# DSO360 - ETAPE 2 : Liste paginee des scans
# ----------------------------------------------------------
Write-Host ""
Write-Host "[DSO360-2] Recuperation de la liste des applications scannees..." -ForegroundColor Cyan

$allScansDSO360 = @()
$dsoPage        = 0
$dsoPageSize    = 100
$dsoTotalPages  = 1

do {
    try {
        Write-Host "  -> Page $($dsoPage + 1)..." -ForegroundColor Yellow

        $uriScans = "$baseUrlDSO360API/dso-api/v1/sca/projects/scans?page=$dsoPage`&size=$dsoPageSize"

        $responseScans = Invoke-WebRequest -UseBasicParsing `
            -Uri $uriScans `
            -WebSession $session `
            -Headers $headersDSO360

        if ($responseScans.Content) {
            $jsonData = $responseScans.Content | ConvertFrom-Json

            if ($jsonData.PSObject.Properties.Name -contains "content") {
                $apps          = $jsonData.content
                $dsoTotalPages = $jsonData.totalPages
            }
            elseif ($jsonData -is [System.Array]) {
                $apps          = $jsonData
                $dsoTotalPages = 1
            }
            elseif ($jsonData.PSObject.Properties.Name -contains "applications") {
                $apps          = $jsonData.applications
                $dsoTotalPages = 1
            }
            else {
                $apps          = @($jsonData)
                $dsoTotalPages = 1
            }

            $allScansDSO360 += $apps
            Write-Host "    OK - Page $($dsoPage + 1)/$dsoTotalPages : $($apps.Count) entree(s)." -ForegroundColor Green
        }

        $dsoPage++
    }
    catch {
        Write-Warning "ATTENTION - Erreur page $dsoPage DSO360 : $_"
        break
    }

} while ($dsoPage -lt $dsoTotalPages)

Write-Host ""
Write-Host "OK - $($allScansDSO360.Count) entrees DSO360 recuperees." -ForegroundColor Green

# ----------------------------------------------------------
# DSO360 - ETAPE 3 : Construction des tables de lookup
# Priorite : CIA > nom exact > nom partiel
# ----------------------------------------------------------
Write-Host ""
Write-Host "[DSO360-3] Construction des tables de correspondance DSO360..." -ForegroundColor Cyan

$dso360MapByCia  = @{}
$dso360MapByName = @{}

foreach ($scanEntry in $allScansDSO360) {

    $appName = if ($scanEntry.name)        { $scanEntry.name }
               elseif ($scanEntry.appName) { $scanEntry.appName }
               elseif ($scanEntry.project) { $scanEntry.project }
               else                        { "N/A" }

    $lastScan = if ($scanEntry.lastScan)         { $scanEntry.lastScan }
                elseif ($scanEntry.lastScanDate)  { $scanEntry.lastScanDate }
                elseif ($scanEntry.scanDate)      { $scanEntry.scanDate }
                elseif ($scanEntry.updatedAt)     { $scanEntry.updatedAt }
                else                              { "N/A" }

    $nbModules = if ($scanEntry.modules)   { ($scanEntry.modules | Measure-Object).Count }
                 elseif ($scanEntry.scans) { ($scanEntry.scans   | Measure-Object).Count }
                 else                      { 0 }

    $scanObj = [PSCustomObject]@{
        AppName   = $appName
        LastScan  = $lastScan
        Status    = if ($scanEntry.status) { $scanEntry.status } else { "N/A" }
        NbModules = $nbModules
        RawEntry  = $scanEntry
    }

    # Index par CIA si disponible
    if ($scanEntry.cia -and -not [string]::IsNullOrWhiteSpace($scanEntry.cia)) {
        $k = $scanEntry.cia.Trim()
        if (-not $dso360MapByCia.ContainsKey($k)) { $dso360MapByCia[$k] = $scanObj }
    }

    # Index par nom normalise
    if ($appName -ne "N/A") {
        $k = $appName.Trim().ToLower()
        if (-not $dso360MapByName.ContainsKey($k)) { $dso360MapByName[$k] = $scanObj }
    }
}

Write-Host "OK - Index CIA  : $($dso360MapByCia.Count) entrees." -ForegroundColor Green
Write-Host "     Index Nom  : $($dso360MapByName.Count) entrees." -ForegroundColor White

# ============================================================
# PARTIE 3 : ENRICHISSEMENT DSO360
# Toutes les apps DORA sont conservees.
# Les champs DSO360 sont renseignes uniquement pour les apps DEV.
# Les autres apps gardent "N/A".
# ============================================================
Write-Host ""
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "  PARTIE 3 : ENRICHISSEMENT DSO360 (apps Specific Dev)" -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan

$matchedCount   = 0
$unmatchedCount = 0
$devAppsCount   = 0
$nonDevCount    = 0

foreach ($doraApp in $enrichedAppsDORA) {

    # Verification nature DEV
    $isSpecificDev = $false
    if ($doraApp.characteristicCriteria -and $doraApp.characteristicCriteria.natures) {
        $isSpecificDev = ($doraApp.characteristicCriteria.natures |
                          Where-Object { $_.code -eq "DEV" } |
                          Measure-Object).Count -gt 0
    }

    # Apps non-DEV : on laisse les champs DSO360 a "N/A"
    if (-not $isSpecificDev) {
        $nonDevCount++
        continue
    }

    $devAppsCount++

    $ciaKey   = $doraApp.cia_key
    $doraName = if ($doraApp.name)        { $doraApp.name }
                elseif ($doraApp.appName) { $doraApp.appName }
                else                      { "" }

    $dsoMatch  = $null
    $matchType = "AUCUN"

    # Tentative 1 : CIA
    if (-not [string]::IsNullOrWhiteSpace($ciaKey) -and $dso360MapByCia.ContainsKey($ciaKey)) {
        $dsoMatch  = $dso360MapByCia[$ciaKey]
        $matchType = "CIA"
    }

    # Tentative 2 : Nom exact
    if (-not $dsoMatch -and -not [string]::IsNullOrWhiteSpace($doraName)) {
        $nameKey = $doraName.Trim().ToLower()
        if ($dso360MapByName.ContainsKey($nameKey)) {
            $dsoMatch  = $dso360MapByName[$nameKey]
            $matchType = "NOM_EXACT"
        }
    }

    # Tentative 3 : Nom partiel
    if (-not $dsoMatch -and -not [string]::IsNullOrWhiteSpace($doraName)) {
        $nameKey = $doraName.Trim().ToLower()
        foreach ($dsoKey in $dso360MapByName.Keys) {
            if ($dsoKey -like "*$nameKey*" -or $nameKey -like "*$dsoKey*") {
                $dsoMatch  = $dso360MapByName[$dsoKey]
                $matchType = "NOM_PARTIEL"
                break
            }
        }
    }

    # Mise a jour des champs DSO360 sur l'objet enrichi
    if ($dsoMatch) {
        $matchedCount++
        $doraApp.DSO360_Matched   = $true
        $doraApp.DSO360_MatchType  = $matchType
        $doraApp.DSO360_AppName    = $dsoMatch.AppName
        $doraApp.DSO360_LastScan   = $dsoMatch.LastScan
        $doraApp.DSO360_ScanStatus = $dsoMatch.Status
        $doraApp.DSO360_NbModules  = $dsoMatch.NbModules
        $doraApp.DSO360_RawEntry   = $dsoMatch.RawEntry
        Write-Host "  [MATCH-$matchType] $doraName (CIA: $ciaKey) --> Scan : $($dsoMatch.LastScan)" -ForegroundColor Green
    }
    else {
        $unmatchedCount++
        $doraApp.DSO360_Matched   = $false
        $doraApp.DSO360_MatchType  = "AUCUN"
        $doraApp.DSO360_AppName    = "N/A"
        $doraApp.DSO360_LastScan   = "N/A"
        $doraApp.DSO360_ScanStatus = "N/A"
        $doraApp.DSO360_NbModules  = 0
        $doraApp.DSO360_RawEntry   = $null
        Write-Host "  [NO MATCH] $doraName (CIA: $ciaKey)" -ForegroundColor Yellow
    }
}

Write-Host ""
Write-Host "  Resume enrichissement :" -ForegroundColor Cyan
Write-Host "  -> Total apps DORA                    : $($enrichedAppsDORA.Count)" -ForegroundColor White
Write-Host "  -> Apps 'Specific development' (DEV)  : $devAppsCount" -ForegroundColor White
Write-Host "  -> Apps non-DEV (DSO360 = N/A)        : $nonDevCount" -ForegroundColor White
Write-Host "  -> DEV avec scan DSO360 (MATCH)       : $matchedCount" -ForegroundColor Green
Write-Host "  -> DEV sans scan DSO360 (NO MATCH)    : $unmatchedCount" -ForegroundColor Yellow

# ============================================================
# PARTIE 4 : SAUVEGARDE - Fichier JSON unique centralise
# DATA_EXTRACT_Security_KPI_dd_YYYYMMDD_HHmmss.json
# ============================================================
Write-Host ""
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "  PARTIE 4 : SAUVEGARDE DU FICHIER JSON CENTRALISE" -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan

# Detail par nature pour les metadonnees
$detailParNature = @()
foreach ($nat in $naturesConfig) {
    $nb = ($enrichedAppsDORA | Where-Object {
        $_.characteristicCriteria.natures -and
        ($_.characteristicCriteria.natures | Where-Object { $_.code -eq $nat.code }).Count -gt 0
    }).Count
    $detailParNature += [PSCustomObject]@{
        code       = $nat.code
        labelEn    = $nat.labelEn
        labelFr    = $nat.labelFr
        legacyCode = $nat.legacyCode
        count      = $nb
    }
}

$globalOutput = [PSCustomObject]@{

    MetaData = [PSCustomObject]@{
        DateExtraction         = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        ScriptVersion          = "1.5"
        CleUnique              = "cia"
        Description            = "Extraction complete DORA enrichie avec scans DSO360 SCA"

        # Stats DORA
        TotalAppsDORA          = $enrichedAppsDORA.Count
        AppsAvecNature         = $appsWithNature
        AppsSansNature         = $appsWithoutNature
        DetailParNature        = $detailParNature

        # Stats DSO360
        TotalScansDSO360       = $allScansDSO360.Count
        DSO360IndexCIA         = $dso360MapByCia.Count
        DSO360IndexNom         = $dso360MapByName.Count
        DSO360Summary          = $dso360Summary

        # Stats jointure DEV
        TotalAppsSpecificDev   = $devAppsCount
        TotalAppsNonDev        = $nonDevCount
        TotalMatchesDSO360     = $matchedCount
        TotalUnmatchedDSO360   = $unmatchedCount

        # Legende champs DSO360
        LegendeChampsDSO360    = [PSCustomObject]@{
            DSO360_Matched    = "true/false pour apps DEV | N/A pour apps non-DEV"
