}

# ─────────────────────────────────────────────────────────────
# 5. Recapitulatif final
# ─────────────────────────────────────────────────────────────

# Largeurs des colonnes
$col1 = 13   # CIA
$col2 = 31   # STATUT
$col3 = 10   # MODULES
$col4 = 52   # moduleName
$col5 = 20   # LAST SCAN DATE

$couleurs_modules = @("Cyan", "White")
$separateurBloc   = ("=" * ($col1 + $col2 + $col3 + $col4 + $col5 + 4))

Write-Host ""
Write-Host $separateurBloc -ForegroundColor DarkCyan
Write-Host "  RECAPITULATIF FINAL" -ForegroundColor Cyan
Write-Host $separateurBloc -ForegroundColor DarkCyan
Write-Host ""

# En-tête
$entete = "{0,-$col1} {1,-$col2} {2,-$col3} {3,-$col4} {4,-$col5}" -f `
    "CIA", "STATUT", "MODULES", "moduleName", "LAST SCAN DATE"
$separateurEntete = "{0,-$col1} {1,-$col2} {2,-$col3} {3,-$col4} {4,-$col5}" -f `
    ("-" * ($col1-1)), ("-" * ($col2-1)), ("-" * ($col3-1)), ("-" * ($col4-1)), ("-" * ($col5-1))

Write-Host $entete          -ForegroundColor Yellow
Write-Host $separateurEntete -ForegroundColor DarkGray
Write-Host ""

foreach ($r in $resultatsGlobaux) {

    $couleurPrincipale = switch ($r.Statut) {
        "Succes"                    { "Green"      }
        "Non existante dans DSO360" { "DarkYellow" }
        default                     { "Red"        }
    }

    if ($r.Modules -and $r.Modules.Count -gt 0) {

        $indexMod = 0
        foreach ($mod in $r.Modules) {

            $couleurModule = $couleurs_modules[$indexMod % 2]

            # CIA toujours affiché, statut et nb uniquement sur la 1ère ligne
            if ($indexMod -eq 0) {
                $statut_col = $r.Statut
                $nb_col     = $r.NombreModules
            } else {
                $statut_col = ""
                $nb_col     = ""
            }

            $partieGauche = "{0,-$col1} {1,-$col2} {2,-$col3} " -f $r.CIA, $statut_col, $nb_col
            $partieDroite = "{0,-$col4} {1,-$col5}"             -f $mod.Nom, $mod.LastScanDate

            Write-Host $partieGauche -ForegroundColor $couleurPrincipale -NoNewline
            Write-Host $partieDroite -ForegroundColor $couleurModule

            $indexMod++
        }
    }
    else {
        # Pas de modules (non existante ou erreur)
        $partieGauche = "{0,-$col1} {1,-$col2} {2,-$col3} " -f $r.CIA, $r.Statut, "0"
        $partieDroite = "{0,-$col4} {1,-$col5}"             -f "-", "-"
        Write-Host $partieGauche -ForegroundColor $couleurPrincipale -NoNewline
        Write-Host $partieDroite -ForegroundColor DarkGray
    }

    # Séparateur léger entre chaque application
    Write-Host (" " * $col1 + "-" * ($col2 + $col3 + $col4 + $col5 + 3)) -ForegroundColor DarkGray
}

# ─────────────────────────────────────────────────────────────
# Compteurs finaux
# "Non existantes DSO360" = toutes les applications avec 0 module
# (HTTP 404 + réponse vide + 0 module retourné)
# ─────────────────────────────────────────────────────────────
$totalSucces     = ($resultatsGlobaux | Where-Object { $_.Statut -eq "Succes" }).Count
$totalInexistant = ($resultatsGlobaux | Where-Object { $_.NombreModules -eq 0 }).Count
$totalErreurs    = ($resultatsGlobaux | Where-Object { $_.Statut -eq "Erreur" }).Count
$totalModules    = $tousLesModules.Count

Write-Host ""
