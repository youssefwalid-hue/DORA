function Decode-JWTInfo {
    param([string]$Token)
    try {
        $parts = $Token.Split(".")
        if ($parts.Count -lt 2) { return $null }
        $payload = $parts[1]
        $padded  = $payload.PadRight($payload.Length + (4 - $payload.Length % 4) % 4, "=")
        $padded  = $padded -replace "-", "+" -replace "_", "/"
        $decoded = [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($padded))
        return $decoded | ConvertFrom-Json
    }
    catch { return $null }
}

function Show-TokenInfo {
    param(
        [string]$Token,
        [string]$SystemName
    )

    Write-Host ""
    Write-Host "  Token information [$SystemName]:" -ForegroundColor Cyan

    $jwtData = Decode-JWTInfo -Token $Token
    if ($null -eq $jwtData) {
        Write-Host "  (Unable to decode token information)" -ForegroundColor Gray
        return $true
    }

    if ($jwtData.given_name -and $jwtData.family_name) {
        Write-Host "  User         : $($jwtData.given_name) $($jwtData.family_name)" -ForegroundColor White
    }
    elseif ($jwtData.name) {
        Write-Host "  User         : $($jwtData.name)" -ForegroundColor White
    }
    elseif ($jwtData.preferred_username) {
        Write-Host "  Login        : $($jwtData.preferred_username)" -ForegroundColor White
    }

    if ($jwtData.email) {
        Write-Host "  Email        : $($jwtData.email)" -ForegroundColor White
    }

    if ($jwtData.exp) {
        $expDate   = [System.DateTimeOffset]::FromUnixTimeSeconds([int64]$jwtData.exp).ToLocalTime()
        $now       = [System.DateTimeOffset]::Now
        $remaining = $expDate - $now

        if ($remaining.TotalMinutes -lt 0) {
            Write-Host "  Expiration   : EXPIRED since $([Math]::Abs([int]$remaining.TotalMinutes)) minutes" -ForegroundColor Red
            return $false
        }
        elseif ($remaining.TotalMinutes -lt 10) {
            Write-Host "  Expiration   : in $([int]$remaining.TotalMinutes) min - WARNING almost expired" -ForegroundColor Red
        }
        else {
            Write-Host "  Expiration   : $($expDate.ToString('yyyy-MM-dd HH:mm:ss')) (in $([int]$remaining.TotalHours)h $($remaining.Minutes)min)" -ForegroundColor Green
        }
    }
    return $true
}

function Get-BearerToken {
    param(
        [string]$SystemName,
        [string]$SystemUrl,
        [string]$Instructions
    )

    Write-Host ""
    Write-Host "============================================================" -ForegroundColor Cyan
    Write-Host " AUTHENTICATION: $SystemName" -ForegroundColor Cyan
    Write-Host "============================================================" -ForegroundColor Cyan
    Write-Host ""
    Write-Host $Instructions -ForegroundColor White
    Write-Host ""
    Write-Host "Opening browser on: $SystemUrl" -ForegroundColor Yellow

    try {
        Start-Process $SystemUrl
        Write-Host "OK - Browser opened." -ForegroundColor Green
    }
    catch {
        Write-Warning "Unable to open browser automatically."
        Write-Host "Open manually: $SystemUrl" -ForegroundColor Yellow
    }

    $token       = ""
    $attempt     = 0
    $maxAttempts = 3

    while ($token -eq "" -and $attempt -lt $maxAttempts) {
        $attempt++
        Write-Host ""
        Write-Host "Attempt $attempt / $maxAttempts" -ForegroundColor Yellow
        Write-Host "Paste the full Authorization token (Bearer eyJ...):" -ForegroundColor White
        Write-Host "(The token will not be displayed on screen for security reasons)" -ForegroundColor Gray
        Write-Host ""

        $secureToken = Read-Host -AsSecureString "Token $SystemName"

        $bstr       = [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($secureToken)
        $tokenPlain = [System.Runtime.InteropServices.Marshal]::PtrToStringBSTR($bstr)
        [System.Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr)

        $tokenPlain = $tokenPlain.Trim()
        $tokenPlain = $tokenPlain -replace "[\r\n]", ""

        if ($tokenPlain -match "^(?i)Bearer\s+(.+)$") {
            $tokenPlain = $Matches[1].Trim()
        }

        if ([string]::IsNullOrWhiteSpace($tokenPlain)) {
            Write-Warning "Empty token. Please try again."
            continue
        }

        $token = $tokenPlain
        Write-Host ""
        Write-Host "OK - Token [$SystemName] accepted." -ForegroundColor Green

        $valid = Show-TokenInfo -Token $token -SystemName $SystemName
        if ($valid -eq $false) {
            Write-Warning "Expired token. Please obtain a new token and try again."
            $token = ""
        }
    }

    if ($token -eq "") {
        Write-Error "ERROR - Token [$SystemName] invalid after $maxAttempts attempts."
        exit 1
    }

    return $token
}

