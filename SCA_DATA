    )

    $prefix = "[{0}/{1}] [CIA: {2}] [{3}] [Nature: {4}] [" -f $Current, $Total, $CIA, $ApplicationName, $Nature
    Write-Host $prefix -ForegroundColor White -NoNewline

    switch ($Status) {
        "MATCH" {
            Write-Host "MATCH" -ForegroundColor Green -NoNewline
