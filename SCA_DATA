function Write-AppProcessingStatus {
    param(
        [Parameter(Mandatory = $true)][int]$Current,
        [Parameter(Mandatory = $true)][int]$Total,
        [Parameter(Mandatory = $true)][string]$CIA,
        [Parameter(Mandatory = $true)][string]$ApplicationName,
