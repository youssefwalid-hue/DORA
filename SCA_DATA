function Save-JsonUTF8 {
    param(
        [Parameter(Mandatory = $true)][string]$FilePath,
        [Parameter(Mandatory = $true)][object]$Data
    )
    $json = $Data | ConvertTo-Json -Depth 50
    [System.IO.File]::WriteAllText(
        (Join-Path (Get-Location).Path ($FilePath -replace "^\.\\")),
        $json,
        $script:Utf8NoBom
    )
}

function Normalize-Text {
    param([AllowNull()][string]$Text)
    if ([string]::IsNullOrWhiteSpace($Text)) { return "" }
    $normalized = $Text.Trim().ToLowerInvariant()
    $normalized = $normalized -replace '\s+', ' '
    return $normalized
}

function Get-PropertyValue {
    param(
        [Parameter(Mandatory = $true)][object]$Object,
        [Parameter(Mandatory = $true)][string[]]$PropertyNames
    )

    foreach ($name in $PropertyNames) {
        if ($null -ne $Object -and $Object.PSObject.Properties.Name -contains $name) {
            $value = $Object.$name
            if ($null -ne $value -and "$value" -ne "") {
                return $value
            }
        }
    }
    return $null
}

function Test-IsSpecificDevelopment {
    param([object]$App)

    try {
        if ($null -eq $App.characteristicCriteria) { return $false }
        if ($null -eq $App.characteristicCriteria.natures) { return $false }

        foreach ($nat in $App.characteristicCriteria.natures) {
            if ($nat.code -eq "DEV") { return $true }

            $labelEn = if ($nat.labelEn) { "$($nat.labelEn)" } else { "" }
            $labelFr = if ($nat.labelFr) { "$($nat.labelFr)" } else { "" }

            if ($labelEn -match "Specific development") { return $true }
            if ($labelFr -match "Developpement specifique|Développement spécifique") { return $true }
        }

        return $false
    }
    catch {
        $script:Stats.ProcessingErrors++
        return $false
    }
}

